<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bone.lowcode.infra.domain.repository.AppRepository">

    <select id="findAllPaged" parameterType="org.springframework.data.jdbc.mybatis.MyBatisContext" resultType="com.bone.lowcode.infra.domain.model.App">
        select * from system_app limit #{offset},#{pageSize}
    </select>

    <select id="getAppByLimit" parameterType="org.springframework.data.jdbc.mybatis.MyBatisContext" resultType="com.bone.lowcode.infra.domain.model.App">
        select * from system_app limit #{offset},#{pageSize}
    </select>
</mapper>