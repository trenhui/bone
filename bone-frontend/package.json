{
  "name": "bone-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "BONE frontend monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=bone-shell",
    "build": "npm run build --workspaces --if-present",
    "build:apps": "npm run build --workspace=bone-shell --workspace=bone-iam-app --workspace=bone-metadata-app --workspace=bone-masterdata-app --workspace=bone-integration-app --workspace=bone-system-app --workspace=bone-extension-app --workspace=bone-generator-app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "overrides": {
    "antd": "5.27.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chalk": "^2.2.0",
    "@types/lodash-es": "^4.17.9",
    "@types/node": "^24.9.1",
    "@types/ora": "^3.2.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/coverage-v8": "^2.0.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.0.2",
    "ora": "^8.1.0",
    "prettier": "^3.1.1",
    "rollup-plugin-visualizer": "^5.9.2",
    "typescript": "^5.3.3",
    "unzipper": "^0.12.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.5.3",
    "vite-plugin-qiankun": "^1.0.15",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
