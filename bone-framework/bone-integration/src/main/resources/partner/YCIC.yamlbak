partnerName: "YCIC"
partnerNameCn: "永诚财险"
interfaces:
  - interfaceName: "registerClaim"
    interfaceNameCn: "案件立案"
    protocol: "HTTP"
    uri: "http://ycic.com/api/v1/claims/register"
    authConfig:
      authType: "Basic"
      username: "ycic_user"
      password: "ycic_password"
    mappingFile: "/path/to/atlasmap/ycic/registerClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "acknowledgeClaim"
    interfaceNameCn: "案件签收"
    protocol: "WEBSERVICE"
    uri: "http://ycic.com/ws/claims/acknowledge"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YCIC_TOKEN"
    mappingFile: "/path/to/atlasmap/ycic/acknowledgeClaim.adm"
    inputFormat: "XML"
    outputFormat: "XML"

  - interfaceName: "finalizeClaim"
    interfaceNameCn: "结案处理"
    protocol: "HTTP"
    uri: "http://ycic.com/api/v1/claims/finalize"
    authConfig:
      authType: "Basic"
      username: "ycic_user"
      password: "ycic_password"
    mappingFile: "/path/to/atlasmap/ycic/finalizeClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "withdrawClaim"
    interfaceNameCn: "撤销案件"
    protocol: "FTP"
    uri: "ftp://ycic.com/claims/withdraw"
    authConfig:
      authType: "Basic"
      username: "ftp_user"
      password: "ftp_password"
    mappingFile: "/path/to/atlasmap/ycic/withdrawClaim.adm"
    inputFormat: "CSV"
    outputFormat: "CSV"

  - interfaceName: "submitIssueClaim"
    interfaceNameCn: "提交问题件"
    protocol: "WEBSERVICE"
    uri: "http://ycic.com/ws/claims/issue"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YCIC_TOKEN"
    mappingFile: "/path/to/atlasmap/ycic/submitIssueClaim.adm"
    inputFormat: "XML"
    outputFormat: "XML"

  - interfaceName: "closureFeedback"
    interfaceNameCn: "结案反馈"
    protocol: "HTTP"
    uri: "http://ycic.com/api/v1/claims/closure-feedback"
    authConfig:
      authType: "Basic"
      username: "ycic_user"
      password: "ycic_password"
    mappingFile: "/path/to/atlasmap/ycic/closureFeedback.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "paymentFeedback"
    interfaceNameCn: "支付反馈"
    protocol: "FTP"
    uri: "ftp://ycic.com/claims/payment-feedback"
    authConfig:
      authType: "Basic"
      username: "ftp_user"
      password: "ftp_password"
    mappingFile: "/path/to/atlasmap/ycic/paymentFeedback.adm"
    inputFormat: "CSV"
    outputFormat: "CSV"