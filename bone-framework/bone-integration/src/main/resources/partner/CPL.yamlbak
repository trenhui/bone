partnerName: "CPL"
partnerNameCn: "中邮人寿"
interfaces:
  - interfaceName: "registerClaim"
    interfaceNameCn: "案件立案"
    protocol: "HTTP"
    uri: "http://cpl.com/api/v1/claims/register"
    authConfig:
      authType: "Basic"
      username: "cpl_user"
      password: "cpl_password"
    mappingFile: "/path/to/atlasmap/cpl/registerClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "acknowledgeClaim"
    interfaceNameCn: "案件签收"
    protocol: "FTP"
    uri: "ftp://cpl.com/claims/acknowledge"
    authConfig:
      authType: "Basic"
      username: "ftp_user"
      password: "ftp_password"
    mappingFile: "/path/to/atlasmap/cpl/acknowledgeClaim.adm"
    inputFormat: "CSV"
    outputFormat: "CSV"

  - interfaceName: "finalizeClaim"
    interfaceNameCn: "结案处理"
    protocol: "WEBSERVICE"
    uri: "http://cpl.com/ws/claims/finalize"
    authConfig:
      authType: "Bearer"
      token: "YOUR_CPL_TOKEN"
    mappingFile: "/path/to/atlasmap/cpl/finalizeClaim.adm"
    inputFormat: "XML"
    outputFormat: "XML"

  - interfaceName: "withdrawClaim"
    interfaceNameCn: "撤销案件"
    protocol: "HTTP"
    uri: "http://cpl.com/api/v1/claims/withdraw"
    authConfig:
      authType: "Basic"
      username: "cpl_user"
      password: "cpl_password"
    mappingFile: "/path/to/atlasmap/cpl/withdrawClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "submitIssueClaim"
    interfaceNameCn: "提交问题件"
    protocol: "HTTP"
    uri: "http://cpl.com/api/v1/claims/issue"
    authConfig:
      authType: "Basic"
      username: "cpl_user"
      password: "cpl_password"
    mappingFile: "/path/to/atlasmap/cpl/submitIssueClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "closureFeedback"
    interfaceNameCn: "结案反馈"
    protocol: "HTTP"
    uri: "http://cpl.com/api/v1/claims/closure-feedback"
    authConfig:
      authType: "Basic"
      username: "cpl_user"
      password: "cpl_password"
    mappingFile: "/path/to/atlasmap/cpl/closureFeedback.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "paymentFeedback"
    interfaceNameCn: "支付反馈"
    protocol: "FTP"
    uri: "ftp://cpl.com/claims/payment-feedback"
    authConfig:
      authType: "Basic"
      username: "ftp_user"
      password: "ftp_password"
    mappingFile: "/path/to/atlasmap/cpl/paymentFeedback.adm"
    inputFormat: "CSV"
    outputFormat: "CSV"