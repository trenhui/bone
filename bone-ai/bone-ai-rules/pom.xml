<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../bone-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.bone</groupId>
    <artifactId>bone-ai-rules</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Bone AI Rules</name>
    <description>规则 DSL 求值（QLExpress 唯一）+ 成本红线桥（规则命中不调 LLM）；最小版=内存注册表，治理面/持久化留批二</description>

    <dependencies>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
        </dependency>
        <!-- 唯一持久化方案（HC-001）：Repository 动态代理 + 实体注解（@Table/@Column） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-sdk</artifactId>
        </dependency>
        <!-- 规则 DSL 唯一引擎（AI 中台 §4.3 定案；bone-parent 托管版本） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>qlexpress4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 端到端成本红线集成测试用（规则命中→shortCircuited→网关跳过 LLM） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-ai-gateway</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
