<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../bone-parent/pom.xml</relativePath>
    </parent>

    <groupId>com.bone</groupId>
    <artifactId>bone-ai-trace</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Bone AI Trace</name>
    <description>AI 证据链：监听 LLM 调用事件落不可篡改快照（输入哈希 + IR + 引擎版本三元组）+ 回放查询</description>

    <dependencies>
        <!-- 共享内核（TenantAggregateRoot / 注解 / TenantContext / DomainEvent） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
        </dependency>
        <!-- 唯一持久化方案（HC-001） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-sdk</artifactId>
        </dependency>
        <!-- 订阅 gateway 发布的 LlmCallRecorded 事件 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-ai-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
