<view class="page">
    <view class="hero">
        <text class="eyebrow">BONE · SYNAP CLAIM</text>
        <text class="title">智能理赔</text>
        <text class="subtitle">员工端 · 移动报案入口</text>
    </view>

    <view class="content-card">
        <text class="section-title">欢迎使用移动报案</text>
        <text class="section-description">{{loggedIn ? '你已登录，可提交理赔报案。' : '请先登录，再提交理赔报案。'}}</text>
        <view class="entry-list">
            <view class="entry-item" bindtap="goReport">
                <text class="entry-title">理赔报案</text>
                <text class="entry-desc">填写保单与费用明细，提交后生成赔案号</text>
                <text class="entry-arrow">›</text>
            </view>
            <view class="entry-item" bindtap="goLogin" wx:if="{{!loggedIn}}">
                <text class="entry-title">员工登录</text>
                <text class="entry-desc">使用 Bone IAM 账号登录</text>
                <text class="entry-arrow">›</text>
            </view>
        </view>
        <view class="account-row" wx:if="{{loggedIn}}">
            <text class="account-text">{{accountName}} · {{tenantName}}</text>
            <text class="account-action" bindtap="handleLogout">退出登录</text>
        </view>
    </view>

    <view class="demo-panel">
        <text class="demo-title">服务配置</text>
        <text class="demo-desc">{{gateway}}</text>
        <text class="demo-note">正式发布请将 config.js 的 GATEWAY 改为微信 request 合法域名。</text>
    </view>
</view>
