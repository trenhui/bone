rocuraai-oversight-effectiveness/tasks.md":"813ab149d330226a62faac5e166e400d914819cc76f6cc8197ec7124a774d2f0","docs/superpowers/plans/procuraai-oversight-effectiveness.md":"88b73e7e441a6f7786c530fa89504d1fb3159025e9bea771a55f51fd1c3f9e9d"},"files":{"openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.comet/archive-documents.json":"b02949e61083859af9863d7fe1e61c24d86435aca3aa5e47f7f2c53696703739","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.comet/archive-requirements.json":"f20e1d13bd12ebc3aeef81f1edfe7ffafae9d772147c6364c6a6ea358c9c2562","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.comet/handoff/design-context.json":"d348a8b11c41f06c28ead594e73bd902eab981eba0eee2611f065d06c73fdff0","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.comet/handoff/design-context.md":"ffa0a697d064980f876844e1dc888ad15fc8d849ceae3dfe523f3429cb36ab1a","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.openspec.yaml":"3c3c72cd1a100807c59ef8347538654b4d2d22269f59561c985b01cb44c39491","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/design.md":"3a7398ba889a8ca50d29ddcf2cc8ae754ed2fb4db4fbe03d5d623e108c8e72bd","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/proposal.md":"8ac1e048c93face4032f02be06697dfa9570233b2860243b27f9c49536987e9a","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/specs/procurement/ai-oversight-effectiveness/spec.md":"173f930d71e32daff3300a5240ad69c12a81fa45d0bf2ff9cbfe47d3eac5d6cd","openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/tasks.md":"813ab149d330226a62faac5e166e400d914819cc76f6cc8197ec7124a774d2f0","docs/superpowers/plans/procuraai-oversight-effectiveness.md":"a7282a87852e022d55902962b2b06c2e32e91eda6c17b1ebedf847ab73fcb71e","openspec/specs/procurement/ai-oversight-effectiveness/spec.md":"ee5f769895b1ad83787e2640419b5de3609374d9490efe0786f727ea8eb4c01a"},"optionalFiles":{"openspec/changes/archive/2026-11-25-procuraai-oversight-effectiveness/.comet-state.lock/.comet-runtime-migration.json":"f79598b12d9fae30bd79218999aac24c92475b9d776dad940d40ace65879dee8"},"recoveryApproval":{"proposalHash":"719213175d3d54974a0b3736c37a244f7990fc7e24d51c8bb148dd5bbfd5f400","changes":[{"path":"openspec/specs/procurement/ai-oversight-effectiveness/spec.md","before":null,"after":"# procurement/ai-oversight-effectiveness Specification\n\n## Purpose\n为采购 AI 治理提供人类监督有效性的只读观测能力：基于人工终决台账的真实记录，以 fail-closed 三态判词识别复核流于形式（耗时过短）、推翻无理由、推翻未回流评测三类监督质量失真，帮助 owner 判断是否需要强化人工监督，同时明确不声明模型效果达标、不替代人工终决。\n\n## Requirements\n\n### Requirement: 监督有效性三态判词\n\n系统 SHALL 对指定能力码计算监督有效性信号，判词只能是 UNDETERMINED、NO_ACTIONABLE_SIGNAL、REVIEW_REQUIRED 三态之一；任何判词都不得对外声明\"模型达标/模型健康/监督充分\"，也不得自动改变任何能力状态或绕过人工终决。\n\n系统 SHALL 仅依据人工终决台账的真实记录计算，识别以下三类可复核风险：\n- 复核耗时低于 owner 配置的时长下限（`reviewDurationFloorMs`）视为\"橡皮图章复核\"；\n- AI 结论与人工结论不一致（override）但理由为空视为\"无理由推翻\"；\n- override 但 `evaluationFeedbackRaised` 为假视为\"未回流评测\"。\n\n> 边界说明（诚实口径）：本 capability 是**只读审计护栏**，不改变人工终决既有契约。当前人工终决写入路径在 override 时自动把 `evaluationFeedbackRaised` 置为真（\"推翻即触发评测增补\"的既有承诺），因此通过本系统 API 新建的 override 不会命中\"未回流评测\"；该检查覆盖的是台账中标记确为假的记录（历史遗留、数据迁移或外部写入）。调用方不得据此声称\"新数据已被检测为回流正常\"。让新数据的回流标记由真实评测回流流程显式赋值属于人工终决契约变更，需独立立项，不在本 capability 范围内。\n\n#### Scenario: 阈值未配置时不可判定\n- **WHEN** 能力已登记且存在人工终决记录，但监督阈值未配置\n- **THEN** 判词为 UNDETERMINED，原因为阈值未配置，不返回监督质量结论\n\n#### Scenario: 样本不足时不可判定\n- **WHEN** 已配置阈值，但人工终决记录数低于最小样本量\n- **THEN** 判词为 UNDETERMINED，原因为样本不足，不返回监督质量结论\n\n#### Scenario: 橡皮图章复核触阈需复核\n- **WHEN** 已配置阈值且样本充足，复核耗时低于下限的记录达到或超过 owner 配置的比例阈值\n- **THEN** 判词为 REVIEW_REQUIRED，原因码标注复核耗时过短，返回真实计数，提示需 owner 复核监督流程，且不自动改变能力状态\n\n#### Scenario: 无理由推翻需复核\n- **WHEN** 已配置阈值且样本充足，存在 override 但理由为空的记录\n- **THEN** 判词为 REVIEW_REQUIRED，原因码标注无理由推翻，返回真实计数，且不自动改变能力状态\n\n#### Scenario: 未回流评测需复核\n- **WHEN** 已配置阈值且样本充足，台账中存在 override 但 `evaluationFeedbackRaised` 为假的记录（历史遗留或外部写入）\n- **THEN** 判词为 REVIEW_REQUIRED，原因码标注未回流评测，返回真实计数，且不自动改变能力状态\n\n#### Scenario: API 新建 override 不命中未回流评测\n- **WHEN** override 由本系统人工终决 API 新建，其 `evaluationFeedbackRaised` 被既有写入路径置为真\n- **THEN** 该记录不计入未回流评测数；系统不得因此对外声称\"回流已被本护栏验证正常\"\n\n#### Scenario: 无风险信号不构成背书\n- **WHEN** 已配置阈值且样本充足，三类风险均未触阈\n- **THEN** 判词为 NO_ACTIONABLE_SIGNAL，且明确该判词不构成模型效果或监督充分性背书\n\n### Requirement: 监督信号 fail-closed 输入约束\n\n系统 SHALL 对非法输入 fail-closed：阈值为负、最小样本量非正、时长下限为负、记录计数为负，均不得产生有效判词。阈值只能由服务端配置提供，不得由 HTTP 请求参数注入。\n\n#### Scenario: 非法阈值被拒绝\n- **WHEN** 配置的时长下限或最小样本量或风险比例为负数\n- **THEN** 该配置被拒绝，不产生监督信号\n\n#### Scenario: 未登记能力不可评估\n- **WHEN** 对未登记的能力码请求监督有效性信号\n- **THEN** 请求被拒绝，不返回任何判词或指标\n\n#### Scenario: 客户端不得注入阈值\n- **WHEN** 调用方尝试通过请求参数覆盖服务端阈值\n- **THEN** 请求参数被忽略或拒绝，判词只依据服务端配置计算\n\n### Requirement: 监督有效性只读观测端点\n\n系统 SHALL 提供需要 `procurement:ai-governance:read` 权限的只读 HTTP 端点，返回能力码、三态判词、原因码、真实计数（样本数/耗时过短数/无理由推翻数/未回流评测数）与\"不构成模型背书\"标记；读操作不得写入追溯链、不得改变能力状态、不得落库。\n\n#### Scenario: 只读端点返回真实计数\n- **WHEN** 具 read 权限的调用方查询已登记能力的监督有效性\n- **THEN** 端点返回 ApiResponse 包装的信号投影，各计数取自人工终决台账的真实记录\n\n#### Scenario: 缺少权限被拒绝\n- **WHEN** 无 `procurement:ai-governance:read` 权限的调用方查询监督有效性\n- **THEN** 请求被拒绝，不返回信号\n\n#### Scenario: 读操作无副作用\n- **WHEN** 多次查询同一能力的监督有效性\n- **THEN** 追溯链条目数不变、能力状态不变、人工终决台账记录数不变、无新增持久化记录\n"}],"specs":{"openspec/specs/ai-governance-console/spec.md":"3031bc557ea65b0c67e4bac29dc9677b4431e4377b304defd178b3d385a76eef","openspec/specs/ai-native-readiness-criteria/spec.md":"3e961a5a371ec9089666a28bee1c06e3e5040f696ebbbb8c1f44e9878d698bbf","openspec/specs/claim/adjustment-strategy-parity/spec.md":"6848de76ce7dab6ba3b71b4cc30b3d958796a4af7f7172cd388359dd9e8f5f89","openspec/specs/claim/ai-calibration-flywheel/spec.md":"224c577f432ca8b6f6dea500cf32c8f0fa7e6c3abac5e4cdf114bdbd95670ec0","openspec/specs/claim/ai-config-governance/spec.md":"3bc6069e3ea3419d5307d78c01532de012f01d40359762c2c9afedbba1d807bb","openspec/specs/claim/ai-knowledge-rag/spec.md":"9bf54340a1984996c6aea8f73736187a75f9867d599f5070f3e4501b236ea6ed","openspec/specs/claim/ai-native-readiness-governance/spec.md":"47fbb5