sks.md":"246101dd11852d176b671dbe7bbd80f251ae7c420d38fa5dea0e570abdc8e717","openspec/changes/synapclaim-risk-fraud-dimensions/verify.sh":"fd98b16df3dab169a40a4a0ef15dbea6fc4e63b2f8f2647a78392f8375ff3818","docs/superpowers/plans/2026-11-17-synapclaim-risk-fraud-dimensions.md":"4fcabf351e485526a8efc69ebf29765195af8b9d4e1a73d601b90c7a12ea2074"},"files":{"openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.comet/archive-documents.json":"8ecc097bfdaab10b9f760c2a89150c8b5ecd5ff7ac8a9caa34206f214139e667","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.comet/archive-requirements.json":"78614fc8f8bf7cf00e92376e10586073ec5debbc1b2a0f9b2261206be9002649","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.comet/handoff/design-context.json":"5b21418cc353ad38dac8986b234120bacadede95690ecb14e152d2265a012b2a","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.comet/handoff/design-context.md":"07ece6a52dc85c685683fab6a9bde4ea537d6eb0c2b91dc7c4420fe5c0d0d754","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.openspec.yaml":"9b4b840064a33a6866a0ebc375b496fbdc2387a324f6c8fb4f21b270218c0d37","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/design.md":"39053fe551f451a1d2b2dfd3dc6956fc4d14da7132a6054250cab6be34786eec","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/proposal.md":"c6574eba92a45d0d77c4f8c78990fbf32e9e70f6404596e7b52b0749c003729b","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/specs/claim/rule-engine/spec.md":"cd9572f698bc08e1f9311fe5be9eca25a2a3737a5041bff85f1ae3140ac3f841","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/tasks.md":"246101dd11852d176b671dbe7bbd80f251ae7c420d38fa5dea0e570abdc8e717","openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/verify.sh":"fd98b16df3dab169a40a4a0ef15dbea6fc4e63b2f8f2647a78392f8375ff3818","docs/superpowers/plans/2026-11-17-synapclaim-risk-fraud-dimensions.md":"f493e39450ab7003e4bf83cbbe0047d04f375997c7b16e98316ebc771ab79fcf","openspec/specs/claim/rule-engine/spec.md":"7757f8e3e123e81bb4a2d573922abb05378a452bc0a48be545dfb762b1eef9b9"},"optionalFiles":{"openspec/changes/archive/2026-11-17-synapclaim-risk-fraud-dimensions/.comet-state.lock/.comet-runtime-migration.json":"88dfbe3394fd3c9d1926eec2efa122039092c9111965e02e0aa2499001c2e528"},"recoveryApproval":{"proposalHash":"4cba351057367fa2973195f497a94730dc5e13bd7dc60aa1c1cefacbb70c2975","changes":[{"path":"openspec/specs/claim/rule-engine/spec.md","before":null,"after":"# claim/rule-engine Specification\n\n## Purpose\n让核责规则引擎的「跨案关联」与「历史行为」维度成为**可执行、可回放、可证伪**的规则资产，\n而非停留在单案标量（金额 / OCR 置信度 / 字段空值）体检。补齐的目标维度仅依赖库内既有\n`insured_id_hash` 列，不引入外部数据源。\n\n## Requirements\n\n### Requirement: 跨案重复索赔识别\n系统 SHALL 在核责上下文富化阶段，按同租户下同一被保人假名化 ID 取出全部赔案（任意状态），\n排除当前案件自身后计算历史案件数 `priorClaimCount`，并在其 ≥1 时命中 `R-FRAUD-22`\n（结论 `PRIOR_CLAIM_DUPLICATE`，计入反欺诈风险）。\n\n#### Scenario: 同一被保人已有历史赔案\n- **WHEN** 新案件核责，同租户同 `insuredIdHash` 下存在 1 条其它赔案\n- **THEN** `priorClaimCount=1`、`R-FRAUD-22` 命中且 `riskHit=true`，规则版本记为 `claim-ruleset-v4`\n\n#### Scenario: 新报案不得把自己算进历史\n- **WHEN** 历史查询结果仅包含当前正在核责的案件本身\n- **THEN** `priorClaimCount=0`，`R-FRAUD-22` 不命中（否则新报案 100% 误报）\n\n### Requirement: 近 90 天高频报案审计留痕\n系统 SHALL 统计排除本案自身后、`createdAt` 位于 `now-90d` 之后的历史案件数\n`recentClaims90d`，并在其 ≥3 时命中 `R-ANOM-03`（结论 `FREQUENCY_ANOMALY`）。\n该规则 MUST 仅作审计留痕（`risk=false`），不得作为硬拒依据，避免对慢病复诊等正常高频小额报案过度拒付。\n\n#### Scenario: 近 90 天 3 案触发审计\n- **WHEN** 同被保人近 90 天存在 3 条其它赔案\n- **THEN** `R-ANOM-03` 与 `R-FRAUD-22` 均命中，但 `R-ANOM-03` 不改变硬闸结果\n\n#### Scenario: 空历史零误报\n- **WHEN** 同被保人无任何历史赔案\n- **THEN** 两条历史维度规则均不命中，核责门禁正常通过\n\n### Requirement: 规则集版本可回放\n规则集新增或改动任一表达式 / 结论码时 MUST 同步 bump 版本号（`claim-ruleset-v3` → `claim-ruleset-v4`），\n使 `t_claim_rule_hit.rule_version` 能区分不同规则集下的命中，回放不混淆。\n\n#### Scenario: 版本随语义变化\n- **WHEN** 规则集新增 `R-FRAUD-22` / `R-ANOM-03`\n- **THEN** 执行结果携带 `version=claim-ruleset-v4`，旧命中记录仍为 v3\n\n### Requirement: 富化降级不阻断主链路\n仓储未装配或查询返回 null / 抛异常时，富化 MUST best-effort 降级为基础 facts\n（`priorClaimCount=0` / `recentClaims90d=0`），不得阻断核责主流程。\n\n#### Scenario: 仓储不可用\n- **WHEN** `claimCaseRepository` 为 null 或 `findByInsuredIdHash` 抛异常\n- **THEN** 两个历史变量按 0 注入，规则正常求值且不抛异常\n"}],"specs":{"openspec/specs/ai-governance-console/spec.md":"3031bc557ea65b0c67e4bac29dc9677b4431e4377b304defd178b3d385a76eef","openspec/specs/ai-native-readiness-criteria/spec.md":"3e961a5a371ec9089666a28bee1c06e3e5040f696ebbbb8c1f44e9878d698bbf","openspec/specs/claim/adjustment-strategy-parity/spec.md":"6848de76ce7dab6ba3b71b4cc30b3d958796a4af7f7172cd388359dd9e8f5f89","openspec/specs/claim/ai-calibration-flywheel/spec.md":"224c577f432ca8b6f6dea500cf32c8f0fa7e6c3abac5e4cdf114bdbd95670ec0","openspec/specs/claim/ai-knowledge-rag/spec.md":"9bf54340a1984996c6aea8f73736187a75f9867d599f5070f3e4501b236ea6ed","openspec/specs/claim/ai-native-readiness-governance/spec.md":"47fbb516230b89cd4be2fb79650d9700d8a75635bebba723353a69b294fd372c","openspec/specs/claim/ai-perception-image/spec.md":"d22e569d1be55a7457856d130e6aa92b0a044d6f1367034847ec0d5951141c47","openspec/specs/claim/biz-identity-registry/spec.md":"42986dce78b384f48225763bf29d3fdb9da2584f8e5da5409328e8e7f91e374c","openspec/specs/claim/case360-embedded-workflow/spec.md":"f29aa9934c8deacb9a86d9c3178dd4cf2ff348fe8738da70d13ff844375824c1","openspec/specs/claim/decision-graph-orchestration/spec.md":"8b1d6f882f54c4f9aa0f4f90fede7763b915ecf930fb7112771500c90c9e87b0","openspec/specs/claim/liability-rule-json-dual-read/spec.md":"de2b435322d8434cf832d28a9fedf68c0d545aeaec86d5271f640b64eae4aaff","openspec/specs/claim/policy-config-two-stage/spec.md":"0241d69b038f7aa5f3ea710de861ddd23ea620d9e1dbf41b7c81614f53c2ba88","openspec/specs/claim/policy-detail-view/spec.md":"ca8413f26a9ba3bd3b8e3b2e86f6ec739d35d7c6d129fcdfaef44477b2a4978d","openspec/specs/claim/reference-catalog-mapping/spec.md":"a88bd0e01ad7e8e7e5457a5d4653988317fe98d18d89597ce4e3f8b395e7554d","openspec/specs