partnerName: "YDL"
partnerNameCn: "英大人寿"
interfaces:
  - interfaceName: "registerClaim"
    interfaceNameCn: "案件立案"
    protocol: "HTTP"
    uri: "http://ydl.com/api/v1/claims/register"
    authConfig:
      authType: "Basic"
      username: "ydl_user"
      password: "ydl_password"
    mappingFile: "/path/to/atlasmap/ydl/registerClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "acknowledgeClaim"
    interfaceNameCn: "案件签收"
    protocol: "HTTP"
    uri: "http://ydl.com/api/v1/claims/acknowledge"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YDL_TOKEN"
    mappingFile: "/path/to/atlasmap/ydl/acknowledgeClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "finalizeClaim"
    interfaceNameCn: "结案处理"
    protocol: "WEBSERVICE"
    uri: "http://ydl.com/ws/claims/finalize"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YDL_TOKEN"
    mappingFile: "/path/to/atlasmap/ydl/finalizeClaim.adm"
    inputFormat: "XML"
    outputFormat: "XML"

  - interfaceName: "withdrawClaim"
    interfaceNameCn: "撤销案件"
    protocol: "FTP"
    uri: "ftp://ydl.com/claims/withdraw"
    authConfig:
      authType: "Basic"
      username: "ftp_user"
      password: "ftp_password"
    mappingFile: "/path/to/atlasmap/ydl/withdrawClaim.adm"
    inputFormat: "CSV"
    outputFormat: "CSV"

  - interfaceName: "submitIssueClaim"
    interfaceNameCn: "提交问题件"
    protocol: "HTTP"
    uri: "http://ydl.com/api/v1/claims/issue"
    authConfig:
      authType: "Basic"
      username: "ydl_user"
      password: "ydl_password"
    mappingFile: "/path/to/atlasmap/ydl/submitIssueClaim.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"

  - interfaceName: "closureFeedback"
    interfaceNameCn: "结案反馈"
    protocol: "WEBSERVICE"
    uri: "http://ydl.com/ws/claims/closure-feedback"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YDL_TOKEN"
    mappingFile: "/path/to/atlasmap/ydl/closureFeedback.adm"
    inputFormat: "XML"
    outputFormat: "XML"

  - interfaceName: "paymentFeedback"
    interfaceNameCn: "支付反馈"
    protocol: "HTTP"
    uri: "http://ydl.com/api/v1/claims/payment-feedback"
    authConfig:
      authType: "Bearer"
      token: "YOUR_YDL_TOKEN"
    mappingFile: "/path/to/atlasmap/ydl/paymentFeedback.adm"
    inputFormat: "JSON"
    outputFormat: "JSON"