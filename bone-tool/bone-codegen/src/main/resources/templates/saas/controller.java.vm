package $packageName.adapter.controller;

import io.swagger.annotations.Api;
import io.swagger.annotations.ApiOperation;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import $packageName.domain.service.${className}Service;
import $packageName.application.dto.${className}DTO;
import com.bone.metadata.sdk.query.criteria.Criteria;
import com.github.pagehelper.PageInfo;
import java.util.List;

/**
 * $classCommentController
 * @author $author
 * @date $datetime
 */
@RestController
@RequestMapping("/api/v1/$tool.lowerFirst(className)")
@Api(tags = "$classComment管理")
public class ${className}Controller {
    
    @Autowired
    private ${className}Service ${tool.lowerFirst(className)}Service;
    
    /**
     * 保存数据
     * @param dto 数据传输对象
     * @return 响应结果
     */
    @PostMapping("/save")
    @ApiOperation("保存数据")
    public Boolean save(@RequestBody ${className}DTO dto) {
        return ${tool.lowerFirst(className)}Service.saveData(dto);
    }
    
    /**
     * 更新数据
     * @param dto 数据传输对象
     * @return 响应结果
     */
    @PutMapping("/update")
    @ApiOperation("更新数据")
    public Boolean update(@RequestBody ${className}DTO dto) {
        return ${tool.lowerFirst(className)}Service.updateData(dto);
    }
    
    /**
     * 删除数据
     * @param id 主键ID
     * @return 响应结果
     */
    @DeleteMapping("/delete/{id}")
    @ApiOperation("删除数据")
    public Boolean delete(@PathVariable Long id) {
        return ${tool.lowerFirst(className)}Service.deleteData(id);
    }
    
    /**
     * 批量删除数据
     * @param ids 主键ID列表
     * @return 响应结果
     */
    @DeleteMapping("/delete/batch")
    @ApiOperation("批量删除数据")
    public Boolean deleteBatch(@RequestBody List<Long> ids) {
        return ${tool.lowerFirst(className)}Service.deleteBatch(ids);
    }
    
    /**
     * 根据ID查询
     * @param id 主键ID
     * @return 查询结果
     */
    @GetMapping("/get/{id}")
    @ApiOperation("根据ID查询")
    public ${className}DTO getById(@PathVariable Long id) {
        return ${tool.lowerFirst(className)}Service.getById(id);
    }
    
    /**
     * 查询列表
     * @param criteria 查询条件
     * @return 查询结果列表
     */
    @PostMapping("/list")
    @ApiOperation("查询列表")
    public List<${className}DTO> getList(@RequestBody Criteria criteria) {
        return ${tool.lowerFirst(className)}Service.getList(criteria);
    }
    
    /**
     * 分页查询
     * @param criteria 查询条件
     * @param pageNum 页码
     * @param pageSize 每页大小
     * @return 分页结果
     */
    @PostMapping("/page")
    @ApiOperation("分页查询")
    public PageInfo<${className}DTO> getPage(@RequestBody Criteria criteria, 
                                          @RequestParam(defaultValue = "1") Integer pageNum, 
                                          @RequestParam(defaultValue = "10") Integer pageSize) {
        return ${tool.lowerFirst(className)}Service.getPage(criteria, pageNum, pageSize);
    }
}