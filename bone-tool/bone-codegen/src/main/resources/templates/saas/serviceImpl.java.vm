package $packageName.infrastructure.service.impl;

import com.baomidou.mybatisplus.extension.service.impl.ServiceImpl;
import com.github.pagehelper.PageHelper;
import com.github.pagehelper.PageInfo;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.util.CollectionUtils;
import $packageName.domain.entity.$className;
import $packageName.application.dto.${className}DTO;
import $packageName.domain.service.${className}Service;
import $packageName.infrastructure.mapper.${className}Mapper;
import com.bone.metadata.sdk.query.criteria.Criteria;
import javax.validation.Valid;
import java.util.Collections;
import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

/**
 * $classCommentService实现类
 * @author $author
 * @date $datetime
 */
@Service
@Slf4j
public class ${className}ServiceImpl extends ServiceImpl<${className}Mapper, $className> implements ${className}Service {
    
    private final ${className}Mapper ${tool.lowerFirst(className)}Mapper;
    
    @Autowired
    public ${className}ServiceImpl(${className}Mapper ${tool.lowerFirst(className)}Mapper) {
        this.${tool.lowerFirst(className)}Mapper = ${tool.lowerFirst(className)}Mapper;
    }
    
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Boolean saveData(@Valid ${className}DTO dto) {
        if (dto == null) {
            throw new IllegalArgumentException("数据传输对象不能为空");
        }
        
        try {
            $className entity = new $className();
            BeanUtils.copyProperties(dto, entity);
            // 设置创建人、创建时间等公共字段
            boolean result = this.save(entity);
            
            if (result) {
                log.info("保存$classComment成功, ID: {}", entity.getId());
            } else {
                log.error("保存$classComment失败");
                throw new RuntimeException("保存$classComment失败");
            }
            
            return result;
        } catch (IllegalArgumentException e) {
            throw e;
        } catch (Exception e) {
            log.error("保存$classComment异常: {}", e.getMessage(), e);
            throw new RuntimeException("保存$classComment异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Boolean updateData(@Valid ${className}DTO dto) {
        if (dto == null || dto.getId() == null) {
            throw new IllegalArgumentException("数据传输对象或ID不能为空");
        }
        
        try {
            // 检查记录是否存在
            if (!this.existsById(dto.getId())) {
                throw new IllegalArgumentException("$classComment不存在, ID: " + dto.getId());
            }
            
            $className entity = new $className();
            BeanUtils.copyProperties(dto, entity);
            // 设置更新人、更新时间等公共字段
            boolean result = this.updateById(entity);
            
            if (result) {
                log.info("更新$classComment成功, ID: {}", dto.getId());
            } else {
                log.error("更新$classComment失败, ID: {}", dto.getId());
                throw new RuntimeException("更新$classComment失败");
            }
            
            return result;
        } catch (IllegalArgumentException e) {
            throw e;
        } catch (Exception e) {
            log.error("更新$classComment异常, ID: {}, 原因: {}", dto.getId(), e.getMessage(), e);
            throw new RuntimeException("更新$classComment异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Boolean deleteData(Long id) {
        if (id == null || id <= 0) {
            throw new IllegalArgumentException("ID不能为空且必须大于0");
        }
        
        try {
            // 检查记录是否存在
            if (!this.existsById(id)) {
                log.warn("$classComment不存在, ID: {}", id);
                return false;
            }
            
            boolean result = this.removeById(id);
            if (result) {
                log.info("删除$classComment成功, ID: {}", id);
            } else {
                log.error("删除$classComment失败, ID: {}", id);
            }
            
            return result;
        } catch (IllegalArgumentException e) {
            throw e;
        } catch (Exception e) {
            log.error("删除$classComment异常, ID: {}, 原因: {}", id, e.getMessage(), e);
            throw new RuntimeException("删除$classComment异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    @Transactional(rollbackFor = Exception.class)
    public Boolean deleteBatch(List<Long> ids) {
        if (CollectionUtils.isEmpty(ids)) {
            throw new IllegalArgumentException("ID列表不能为空");
        }
        
        try {
            // 验证ID列表
            ids.forEach(id -> {
                if (id == null || id <= 0) {
                    throw new IllegalArgumentException("ID不能为空且必须大于0: " + id);
                }
            });
            
            boolean result = this.removeByIds(ids);
            if (result) {
                log.info("批量删除$classComment成功, 数量: {}", ids.size());
            } else {
                log.error("批量删除$classComment失败, 数量: {}", ids.size());
            }
            
            return result;
        } catch (IllegalArgumentException e) {
            throw e;
        } catch (Exception e) {
            log.error("批量删除$classComment异常, 数量: {}, 原因: {}", ids.size(), e.getMessage(), e);
            throw new RuntimeException("批量删除$classComment异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    public ${className}DTO getById(Long id) {
        if (id == null || id <= 0) {
            throw new IllegalArgumentException("ID不能为空且必须大于0");
        }
        
        return findById(id).orElse(null);
    }
    
    @Override
    public Optional<${className}DTO> findById(Long id) {
        if (id == null || id <= 0) {
            throw new IllegalArgumentException("ID不能为空且必须大于0");
        }
        
        try {
            $className entity = this.getBaseMapper().selectById(id);
            if (entity == null) {
                log.warn("查询$classComment不存在, ID: {}", id);
                return Optional.empty();
            }
            
            ${className}DTO dto = new ${className}DTO();
            BeanUtils.copyProperties(entity, dto);
            return Optional.of(dto);
        } catch (Exception e) {
            log.error("查询$classComment异常, ID: {}, 原因: {}", id, e.getMessage(), e);
            throw new RuntimeException("查询$classComment异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    public List<${className}DTO> getList(Criteria criteria) {
        try {
            List<$className> entityList = ${tool.lowerFirst(className)}Mapper.selectByCriteria(criteria);
            if (CollectionUtils.isEmpty(entityList)) {
                return Collections.emptyList();
            }
            
            return entityList.stream().map(entity -> {
                ${className}DTO dto = new ${className}DTO();
                BeanUtils.copyProperties(entity, dto);
                return dto;
            }).collect(Collectors.toList());
        } catch (Exception e) {
            log.error("查询$classComment列表异常: {}", e.getMessage(), e);
            throw new RuntimeException("查询$classComment列表异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    public Optional<${className}DTO> getOne(Criteria criteria) {
        try {
            List<$className> entityList = ${tool.lowerFirst(className)}Mapper.selectByCriteria(criteria);
            if (CollectionUtils.isEmpty(entityList)) {
                return Optional.empty();
            }
            
            if (entityList.size() > 1) {
                log.warn("查询$classComment返回多条结果，条件: {}", criteria);
            }
            
            ${className}DTO dto = new ${className}DTO();
            BeanUtils.copyProperties(entityList.get(0), dto);
            return Optional.of(dto);
        } catch (Exception e) {
            log.error("查询$classComment单个结果异常: {}", e.getMessage(), e);
            throw new RuntimeException("查询$classComment单个结果异常: " + e.getMessage(), e);
        }
    }
    
    @Override
    public PageInfo<${className}DTO> getPage(Criteria criteria, Integer pageNum, Integer pageSize) {
        // 参数验证
        if (pageNum == null || pageNum < 1) {
            throw new IllegalArgumentException("页码必须大于等于1");
        }
        if (pageSize == null || pageSize < 1 || pageSize > 1000) {
            throw new IllegalArgumentException("每页大小必须在1-1000之间");
        }
        
        try {
            PageHelper.startPage(pageNum, pageSize);
            List<$className> entityList = ${tool.lowerFirst(className)}Mapper.selectByCriteria(criteria);
            PageInfo<$className> pageInfo = new PageInfo<>(entityList);
            
            List<${className}DTO> dtoList = entityList.stream().map(entity -> {
                ${className}DTO dto = new ${className}DTO();
                BeanUtils.copyProperties(entity, dto);
                return dto;
            }).collect(Collectors.toList());
            
            PageInfo<${className}DTO> result = new PageInfo<>(dtoList);
            BeanUtils.copyProperties(pageInfo, result);
            
            log.info("分页查询$classComment成功, 页码: {}, 每页大小: {}, 总记录数: {}", 
                     pageNum, pageSize, result.getTotal());
            
            return result;
        } catch (IllegalArgumentException e) {
            throw e;
        } catch (Exception e) {
            log.error("分页查询$classComment异常, 页码: {}, 每页大小: {}, 原因: {}", 
                     pageNum, pageSize, e.getMessage(), e);
            throw new RuntimeException("分页查询$classComment异常: " + e.getMessage(), e);
        }
    }
}