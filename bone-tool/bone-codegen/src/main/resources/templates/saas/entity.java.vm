package $packageName.domain.entity;

import com.baomidou.mybatisplus.annotation.IdType;
import com.baomidou.mybatisplus.annotation.TableId;
import com.baomidou.mybatisplus.annotation.TableName;
import lombok.Data;
import java.io.Serializable;
#foreach($column in $columns)
#if($column.javaType == "java.util.Date" || $column.javaType == "java.time.LocalDateTime")
import $column.javaType;
#end
#end

/**
 * $classComment
 * @author $author
 * @date $datetime
 */
@Data
@TableName("$table.tableName")
public class $className implements Serializable {
    private static final long serialVersionUID = 1L;

#if($primaryKey)
    /**
     * $primaryKey.comment
     */
    #if($primaryKey.javaType == "java.lang.Long")
    @TableId(value = "$primaryKey.columnName", type = IdType.AUTO)
    #else
    @TableId(value = "$primaryKey.columnName")
    #end
    private $primaryKey.javaType $primaryKey.fieldName;

#end

#foreach($column in $businessColumns)
#if($column.primaryKey)
#continue
#end
    /**
     * $column.comment
     */
    private $column.javaType $column.fieldName;

#end

#if($table.isCreateTime)
    /**
     * 创建时间
     */
    private java.time.LocalDateTime createTime;

#end
#if($table.isUpdateTime)
    /**
     * 更新时间
     */
    private java.time.LocalDateTime updateTime;

#end
#if($table.isCreateBy)
    /**
     * 创建人
     */
    private Long createBy;

#end
#if($table.isUpdateBy)
    /**
     * 更新人
     */
    private Long updateBy;

#end
#if($table.isDelFlag)
    /**
     * 删除标志
     */
    private Integer delFlag;

#end
}