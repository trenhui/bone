<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      synap-claim-settlement : 理算引擎参考实现（双轨验证的独立 oracle 源）

      ⚠️ 本模块是**验证资产，不是产品代码**，不并入 bone-apps/synap-claim，也不在任何
      reactor 内（根目录 mvn clean verify 不覆盖它），执行入口是独立 CI job：
      .github/workflows/synap-claim-oracle.yml。生产实现见
      com.bone.claim.domain.model.adjustment.engine.AdjustmentEngine（V1 九步，另一套语义）。

      六边形架构：domain/engine 为纯逻辑，绝不直接依赖 Spring/DB/网络；
      一切外部能力（BONE-AI 各能力中心）经 port 防腐层消费。
      本模块自带可运行参考实现（InMemory 端口）与 JDBC 端口实现（H2/MySQL 双方言）。
      验证：ProbeSuite（30 探针 + 19 变异对照）+ ScenarioSuite（28 真实 TPA 场景）
      + JdbcPortsIntegrationTest（JDBC 持久化路径：CAS/冲正/预授权 TTL/幂等租约）。
      构建：mvn test   （离线加 -o；CI 用在线模式，避免 runner 缓存缺插件被误判为代码缺陷）
    -->

    <groupId>com.bone.synap</groupId>
    <artifactId>synap-claim-settlement</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.9.3</junit.version>
        <h2.version>2.2.224</h2.version>
    </properties>

    <dependencies>
        <!-- 测试：JUnit 5 + H2（集成测试在内存库验证 JDBC 持久化路径） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
