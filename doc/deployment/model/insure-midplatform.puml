    - risk_score: DECIMAL(5,2)
    - underwriting_result: JSON
    - effective_date: DATE
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class UnderwritingRule {
    - id: BIGINT
    - rule_code: VARCHAR(20)
    - product_config_id: BIGINT
    - rule_type: ENUM('AUTO','MANUAL','HYBRID')
    - underwriting_rules: JSON
    - condition_expression: JSON
    - action_expression: JSON
    - priority: TINYINT UNSIGNED
    - version: VARCHAR(10)
    - status: ENUM('ACTIVE','INACTIVE','DEPRECATED')
    - effective_date: DATE
    - expire_date: DATE
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class HealthProfile {
    - id: BIGINT
    - person_id: BIGINT
    - medical_history: JSON
    - exam_data: JSON
    - wearable_data: JSON
    - genetic_risk: JSON
    - last_updated_at: DATETIME(3)
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

' 保全模块
class Policy {
    - id: BIGINT
    - policy_code: VARCHAR(32)
    - proposal_id: BIGINT
    - product_config_id: BIGINT
    - policyholder_id: BIGINT
    - type: ENUM('INDIVIDUAL','GROUP')
    - status: ENUM('ACTIVE','LAPSED','TERMINATED','ON_HOLD','CANCELLED')
    - premium_amount: DECIMAL(12,2)
    - quota_control_type: ENUM('STATIC','DYNAMIC')
    - quota_reset_cycle: ENUM('NONE','YEARLY','HALF_YEAR')
    - total_quota: DECIMAL(18,2)
    - used_quota: DECIMAL(18,2)
    - coverage_detail: JSON
    - effective_date: DATE
    - expiry_date: DATE
    - renewal_count: TINYINT UNSIGNED
    - pre_policy_id: BIGINT
    - grace_period_days: INT
    - version: INT
    - renewal_policy_id: BIGINT
    - remark: VARCHAR(255)
    - source: VARCHAR(50)
    - last_sync_time: DATETIME(3)
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class PolicyInsured {
    - id: BIGINT
    - relate_id: BIGINT
    - insured_type: ENUM('PROPOSAL','ENDORSEMENT','RENEWAL')
