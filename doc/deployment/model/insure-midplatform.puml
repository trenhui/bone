@startuml

' 基础主数据模块
class SysDataDict {
    - id: BIGINT
    - dict_type: VARCHAR(50)
    - dict_code: VARCHAR(50)
    - dict_value: VARCHAR(512)
    - description: VARCHAR(255)
    - tenant_id: BIGINT
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class Insurer {
    - id: BIGINT
    - insurer_code: VARCHAR(10)
    - insurer_name: VARCHAR(100)
    - contact_phone: VARCHAR(20)
    - contact_address: VARCHAR(600)
    - email: VARCHAR(50)
    - license_number: VARCHAR(50)
    - status: ENUM('ACTIVE','INACTIVE')
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class InsuredPerson {
    - id: BIGINT
    - name: VARCHAR(50)
    - id_type: ENUM('ID_CARD','PASSPORT','HKID','SSN')
    - id_card_no: VARCHAR(256)
    - id_card_hash: CHAR(64)
    - nationality: VARCHAR(50)
    - domicile: VARCHAR(50)
    - mobile: VARCHAR(20)
    - email: VARCHAR(50)
    - gender: ENUM('MALE','FEMALE','UNKNOWN')
    - birth_date: DATE
    - occupation: VARCHAR(100)
    - health_status: JSON
    - source: VARCHAR(50)
    - id_card_key_version: VARCHAR(10)
    - family_id: BIGINT
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class Company {
    - id: BIGINT
    - code: VARCHAR(64)
    - name: VARCHAR(150)
    - parent_company_id: BIGINT
    - industry: VARCHAR(100)
    - employee_count: INT UNSIGNED
    - contact_person: VARCHAR(50)
    - contact_phone: VARCHAR(20)
    - address: VARCHAR(500)
    - email: VARCHAR(50)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class Policyholder {
    - id: BIGINT
    - name: VARCHAR(100)
    - code: VARCHAR(50)
    - holder_id: BIGINT
    - holder_type: ENUM('INDIVIDUAL','FAMILY','COMPANY')
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

' 产品工厂模块
class ProductConfig {
    - id: BIGINT
    - product_code: VARCHAR(20)
    - product_name: VARCHAR(100)
    - insurer_id: BIGINT
    - product_type: ENUM('LIFE','HEALTH','PROPERTY','LIABILITY')
    - coverage_period: VARCHAR(50)
    - premium_frequency: ENUM('ANNUAL','SEMI_ANNUAL','MONTHLY')
    - coverage_schema: JSON
    - pricing_model: JSON
    - underwriting_flow: JSON
    - status: ENUM('DRAFT','ACTIVE','RETIRED','PENDING')
    - product_version: VARCHAR(10)
    - effective_date: DATE
    - expire_date: DATE
    - max_insured_age: INT UNSIGNED
    - min_insured_age: INT UNSIGNED
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

class ProductClause {
    - id: BIGINT
    - product_config_id: BIGINT
    - clause_text: TEXT
    - effective_date: DATE
    - expire_date: DATE
    - tenant_id: BIGINT
    - biz_identity_code: VARCHAR(32)
    - created_at: DATETIME(3)
    - created_by: BIGINT
    - updated_at: DATETIME(3)
    - updated_by: BIGINT
    - deleted: TINYINT
}

' 承保模块
class Proposal {
    - id: BIGINT
    - proposal_code: VARCHAR(32)
    - product_config_id: BIGINT
    - insured_type: ENUM('INDIVIDUAL','FAMILY','GROUP')
    - policyholder_id: BIGINT
    - proposal_channel: ENUM('ONLINE','OFFLINE')
