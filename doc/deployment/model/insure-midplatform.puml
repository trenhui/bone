' 关联关系
SysDataDict --> Policyholder
Insurer --> ProductConfig
InsuredPerson --> PolicyInsured
Company --> Policyholder
Policyholder --> Policy
ProductConfig --> ProductClause
ProductConfig --> Proposal
Proposal --> Policy
UnderwritingRule --> Proposal
HealthProfile --> Proposal
Policy --> PolicyInsured
Policy --> PolicyEndorsement
Policy --> PolicyRenewal
Policy --> PolicyQuotaChange
AuditLog --> Policy
Merchant --> Product
Product --> Category
Goods --> Product
Order --> Merchant
Order --> Policy
Order --> OrderItem
OrderItem --> Goods
ConsumeRule --> Order
RuleExecutionLog --> Order
FundAccount --> VirtualAccount
VirtualAccount --> FamilyGroup
FundLedger --> FundAccount
PaymentException --> Order
BenefitFundCard --> InsuredPerson
FamilyGroup --> FamilyConfig
FamilyGroup --> FamilyMember

@enduml