<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../../bone-parent/pom.xml</relativePath>
    </parent>

    <artifactId>synap-claim</artifactId>
    <name>synap-claim</name>
    <description>synapClaim 智能理赔平台（DDD 四层，实现见 doc/ai-product/synapClaim/ 工程详细设计（落地版））</description>

    <dependencies>
        <!-- Spring Boot -->
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2（仅测试）：装配级冒烟测试的进程内数据源（与 bone-blueprint 同口径） -->
        <dependency><groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security（@PreAuthorize scope 鉴权） -->
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation（Spring Boot 3 使用 jakarta.validation） -->
        <dependency><groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Bone Core（TenantAggregateRoot / ApiResponse / PageResult / BizException / IdempotencyService） -->
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bone Security（JWT 验签链，与 blueprint 一致） -->
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bone Web（统一异常处理 / 统一信封） -->
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-web</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Bone Metadata SDK（HC-001 唯一持久化抽象：@Table/@Column/@Version + Repository） -->
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-metadata-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MySQL Driver -->
        <dependency><groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency><groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct（assembler 协议 DTO <-> Command/Resp） -->
        <dependency><groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Swagger -->
        <dependency><groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ArchUnit + Bone 共享 ArchUnit 规则（《Bone-DDD》§21） -->
        <dependency><groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin><groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <useIncrementalCompilation>false</useIncrementalCompilation>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Second compile pass to compile MapStruct generated sources -->
                    <execution>
                        <id>compile-mapstruct</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
