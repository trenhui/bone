<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-metadata-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bone-metadata-engine-domain</artifactId>
    <name>bone-metadata-engine-domain</name>
    <description>智能元数据引擎领域层：纯净领域模型与算法（零 Spring 零 SDK）</description>

    <properties>
        <!-- HC-005 显式豁免：模块以领域接口/模型为主，无复杂业务逻辑，暂不纳入覆盖率门槛。后续若补关键行为测试再恢复。 -->
        <jacoco.minimum.coverage>0</jacoco.minimum.coverage>
    </properties>

    <dependencies>
        <!-- 本模块自身是 1.0.0-SNAPSHOT：bone-core / bone-architecture-test 是 release（1.0.0），
             必须用固定版本属性，否则 ${project.version} 会解析成不存在的 1.0.0-SNAPSHOT。 -->
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
            <version>${bone-core.version}</version>
        </dependency>
        <dependency><groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency><groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
                        <scope>test</scope>
        </dependency>
        <!-- slf4j：DefaultMetadataRegistry 直接用 Logger/LoggerFactory，本模块此前漏声明
             （同族 -ports 模块已声明）；版本由 Boot BOM 托管，不写 version。 -->
        <dependency><groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency><groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <version>${bone-architecture-test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
