<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-metadata-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>bone-accounting-engine</artifactId>
    <name>bone-accounting-engine</name>
    <description>会计引擎（可复用）：凭证公式/条件求值 + 凭证生成。报销、采购等场景通过动作定义 handler_bean=voucherGenerateHandler 复用。</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 纯装配/领域模块，单测价值有限暂不纳入覆盖率门槛 -->
        <jacoco.minimum.coverage>0</jacoco.minimum.coverage>
    </properties>

    <dependencies>
        <!-- 引擎运行时 SPI 与能力（RuntimeWriteHook/RuntimeActionHandler/JdbcRuntimeRecordService/RuntimeEntityCatalog） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-engine-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 运行期服务与网关（RuntimeRelationApplicationService/TenantProvider/RuntimeActionContext）；
             依赖整个可启动 server 是当前 MVP 技术债，后续应抽出 bone-extension-api 瘦模块（见架构复核） -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
            <version>${bone-core.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <version>${bone-architecture-test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
