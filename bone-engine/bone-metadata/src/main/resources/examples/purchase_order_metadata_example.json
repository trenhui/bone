{
  "apiName": "PurchaseOrder",
  "label": "采购订单",
  "labels": {
    "zh_CN": "采购订单",
    "en_US": "Purchase Order",
    "ja_JP": "発注书"
  },
  "description": "记录企业采购商品或服务的业务单据",
  "domain": "Procurement",
  "entityType": "STANDARD",
  "version": "1.0.0",
  "audited": true,
  "cacheable": true,
  "cacheTTL": 1800,
  "primaryKeyField": "id",
  "createdBy": "admin",
  "createdAt": "2024-01-01T10:00:00Z",
  "updatedBy": "admin",
  "updatedAt": "2024-01-01T10:00:00Z",
  "fields": {
    "id": {
      "name": "id",
      "label": "订单编号",
      "type": "TEXT",
      "required": true,
      "unique": true,
      "maxLength": 32,
      "indexed": true,
      "searchable": true,
      "description": "采购订单唯一标识符",
      "defaultExpression": "PO-{{YYYYMMDD}}-{{seq}}"
    },
    "orderType": {
      "name": "orderType",
      "label": "订单类型",
      "type": "PICKLIST",
      "required": true,
      "description": "采购订单类型",
      "picklistValues": [
        { "value": "REGULAR", "label": "常规订单" },
        { "value": "EMERGENCY", "label": "紧急订单" },
        { "value": "CONTRACT", "label": "框架合同" },
        { "value": "BLANKET", "label": "一揽子订单" }
      ],
      "defaultValue": "REGULAR",
      "indexed": true
    },
    "supplierId": {
      "name": "supplierId",
      "label": "供应商ID",
      "type": "LOOKUP",
      "required": true,
      "description": "供应商唯一标识",
      "indexed": true,
      "uiMetadata": {
        "lookupDisplayField": "supplierName",
        "lookupSearchFields": ["supplierName", "supplierCode"]
      }
    },
    "totalAmount": {
      "name": "totalAmount",
      "label": "订单总额",
      "type": "CURRENCY",
      "required": true,
      "calculated": true,
      "calculationExpression": "sum(details.price * details.quantity)",
      "description": "采购订单总金额",
      "precision": 15,
      "scale": 2,
      "sortable": true
    },
    "currency": {
      "name": "currency",
      "label": "币种",
      "type": "TEXT",
      "required": true,
      "defaultValue": "CNY",
      "maxLength": 3,
      "description": "订单货币类型"
    },
    "deliveryDate": {
      "name": "deliveryDate",
      "label": "预计交货日期",
      "type": "DATE",
      "required": true,
      "description": "供应商预计交货日期",
      "sortable": true
    },
    "status": {
      "name": "status",
      "label": "订单状态",
      "type": "PICKLIST",
      "required": true,
      "description": "订单当前状态",
      "picklistValues": [
        { "value": "DRAFT", "label": "草稿" },
        { "value": "SUBMITTED", "label": "已提交" },
        { "value": "APPROVED", "label": "已审批" },
        { "value": "REJECTED", "label": "已拒绝" },
        { "value": "IN_PROGRESS", "label": "执行中" },
        { "value": "COMPLETED", "label": "已完成" },
        { "value": "CANCELLED", "label": "已取消" }
      ],
      "defaultValue": "DRAFT",
      "indexed": true,
      "sortable": true
    },
    "createdByUser": {
      "name": "createdByUser",
      "label": "创建人",
      "type": "TEXT",
      "required": true,
      "description": "创建采购订单的用户",
      "trackHistory": true
    },
    "department": {
      "name": "department",
      "label": "申请部门",
      "type": "TEXT",
      "required": true,
      "description": "申请采购的部门",
      "indexed": true
    },
    "remark": {
      "name": "remark",
      "label": "备注",
      "type": "TEXT",
      "maxLength": 500,
      "description": "订单相关说明",
      "uiMetadata": {
        "component": "textarea"
      }
    },
    "urgent": {
      "name": "urgent",
      "label": "是否加急",
      "type": "BOOLEAN",
      "defaultValue": false,
      "description": "是否为加急订单"
    },
    "contractId": {
      "name": "contractId",
      "label": "关联合同ID",
      "type": "TEXT",
      "maxLength": 32,
      "description": "关联的框架合同编号",
      "searchable": true
    },
    "approvalProcessId": {
      "name": "approvalProcessId",
      "label": "审批流程ID",
      "type": "TEXT",
      "maxLength": 32,
      "description": "关联的审批流程实例ID"
    },
    "attachments": {
      "name": "attachments",
      "label": "附件列表",
      "type": "ARRAY",
      "description": "订单相关附件",
      "uiMetadata": {
        "component": "fileUpload"
      }
    },
    "extendedAttributes": {
      "name": "extendedAttributes",
      "label": "扩展属性",
      "type": "JSON",
      "description": "订单扩展信息",
      "unstructured": true
    }
  },
  "relationships": [
    {
      "name": "orderDetails",
      "label": "订单明细",
      "type": "ONE_TO_MANY",
      "targetEntity": "PurchaseOrderDetail",
      "sourceField": "id",
      "targetField": "purchaseOrderId",
      "cascade": "ALL",
      "orphanRemoval": true,
      "batchSize": 100,
      "fetchType": "LAZY",
      "description": "采购订单的商品明细",
      "uiMetadata": {
        "gridColumns": 12,
        "displayMode": "TABLE",
        "allowAdd": true,
        "allowEdit": true,
        "allowDelete": true
      }
    },
    {
      "name": "supplier",
      "label": "供应商",
      "type": "MANY_TO_ONE",
      "targetEntity": "Supplier",
      "sourceField": "supplierId",
      "targetField": "id",
      "fetchType": "EAGER",
      "description": "采购订单关联的供应商",
      "uiMetadata": {
        "lookupDisplayField": "supplierName"
      }
    },
    {
      "name": "approvalHistory",
      "label": "审批历史",
      "type": "ONE_TO_MANY",
      "targetEntity": "ApprovalRecord",
      "sourceField": "id",
      "targetField": "sourceEntityId",
      "fetchType": "LAZY",
      "description": "订单审批历史记录"
    }
  ],
  "businessRules": [
    {
      "name": "emergencyOrderDeliveryCheck",
      "description": "紧急订单交货日期检查",
      "condition": "orderType == 'EMERGENCY'",
      "expression": "deliveryDate <= addDays(currentDate(), 3)",
      "errorMessage": "紧急订单交货日期必须在3天内",
      "triggerEvents": ["CREATE", "UPDATE"],
      "priority": 10,
      "severity": "WARNING",
      "aiRiskLevel": "LOW",
      "ruleType": "VALIDATION",
      "active": true
    },
    {
      "name": "contractValidityCheck",
      "description": "框架合同有效性检查",
      "condition": "contractId != null && contractId != ''",
      "expression": "validateContractValidity(contractId, currentDate())",
      "errorMessage": "关联的框架合同无效或已过期",
      "triggerEvents": ["CREATE", "UPDATE", "SUBMIT"],
      "priority": 20,
      "severity": "ERROR",
      "aiRiskLevel": "MEDIUM",
      "ruleType": "VALIDATION",
      "active": true
    },
    {
      "name": "highAmountApprovalRequired",
      "description": "大额订单强制审批",
      "condition": "totalAmount > 100000",
      "expression": "status != 'DRAFT' && status != 'SUBMITTED'",
      "errorMessage": "超过10万元的订单必须经过审批",
      "triggerEvents": ["UPDATE"],
      "priority": 15,
      "severity": "ERROR",
      "aiRiskLevel": "HIGH",
      "ruleType": "VALIDATION",
      "active": true
    },
    {
      "name": "autoSetUrgentFlag",
      "description": "自动设置加急标志",
      "condition": "orderType == 'EMERGENCY'",
      "expression": "urgent = true",
      "triggerEvents": ["CREATE", "UPDATE"],
      "priority": 5,
      "severity": "INFO",
      "ruleType": "AUTOMATION",
      "active": true
    }
  ],
  "processes": [
    {
      "name": "purchaseOrderApprovalProcess",
      "description": "采购订单审批流程",
      "type": "SEQUENTIAL",
      "startNodeId": "start",
      "endNodeIds": ["approved", "rejected", "cancelled"],
      "nodes": [
        {
          "id": "start",
          "name": "开始",
          "type": "START"
        },
        {
          "id": "departmentApproval",
          "name": "部门审批",
          "type": "APPROVAL",
          "properties": {
            "approverType": "DEPARTMENT_HEAD",
            "timeout": 48
          },
          "postAction": "updateApprovalHistory('部门审批', 'PENDING')"
        },
        {
          "id": "financeApproval",
          "name": "财务审批",
          "type": "APPROVAL",
          "properties": {
            "approverType": "FINANCE",
            "timeout": 48,
            "condition": "totalAmount > 50000"
          },
          "preCondition": "departmentApproval.status == 'APPROVED'",
          "postAction": "updateApprovalHistory('财务审批', 'PENDING')"
        },
        {
          "id": "executiveApproval",
          "name": "高管审批",
          "type": "APPROVAL",
          "properties": {
            "approverType": "EXECUTIVE",
            "timeout": 72,
            "condition": "totalAmount > 200000"
          },
          "preCondition": "financeApproval.status == 'APPROVED' || (totalAmount <= 50000 && departmentApproval.status == 'APPROVED')",
          "postAction": "updateApprovalHistory('高管审批', 'PENDING')"
        },
        {
          "id": "approved",
          "name": "审批通过",
          "type": "END",
          "postAction": "updateStatus('APPROVED'); notifySupplier();"
        },
        {
          "id": "rejected",
          "name": "审批拒绝",
          "type": "END",
          "postAction": "updateStatus('REJECTED'); notifyCreator();"
        },
        {
          "id": "cancelled",
          "name": "取消",
          "type": "END",
          "postAction": "updateStatus('CANCELLED'); notifyRelevantParties();"
        }
      ],
      "transitions": [
        { "id": "t1", "fromNodeId": "start", "toNodeId": "departmentApproval" },
        { "id": "t2", "fromNodeId": "departmentApproval", "toNodeId": "financeApproval", "condition": "status == 'APPROVED' && totalAmount > 50000" },
        { "id": "t3", "fromNodeId": "departmentApproval", "toNodeId": "executiveApproval", "condition": "status == 'APPROVED' && totalAmount <= 50000 && totalAmount > 200000" },
        { "id": "t4", "fromNodeId": "departmentApproval", "toNodeId": "approved", "condition": "status == 'APPROVED' && totalAmount <= 50000 && totalAmount <= 200000" },
        { "id": "t5", "fromNodeId": "departmentApproval", "toNodeId": "rejected", "condition": "status == 'REJECTED'" },
        { "id": "t6", "fromNodeId": "financeApproval", "toNodeId": "executiveApproval", "condition": "status == 'APPROVED' && totalAmount > 200000" },
        { "id": "t7", "fromNodeId": "financeApproval", "toNodeId": "approved", "condition": "status == 'APPROVED' && totalAmount <= 200000" },
        { "id": "t8", "fromNodeId": "financeApproval", "toNodeId": "rejected", "condition": "status == 'REJECTED'" },
        { "id": "t9", "fromNodeId": "executiveApproval", "toNodeId": "approved", "condition": "status == 'APPROVED'" },
        { "id": "t10", "fromNodeId": "executiveApproval", "toNodeId": "rejected", "condition": "status == 'REJECTED'" }
      ],
      "variables": {
        "approvalChain": {
          "name": "approvalChain",
          "type": "ARRAY",
          "description": "审批链"
        },
        "currentApprover": {
          "name": "currentApprover",
          "type": "OBJECT",
          "description": "当前审批人"
        }
      },
      "triggerEvents": ["SUBMIT"],
      "transactional": true,
      "timeout": 1209600,
      "version": "1.0.0"
    }
  ],
  "operations": {
    "createPurchaseOrder": {
      "name": "createPurchaseOrder",
      "label": "创建采购订单",
      "description": "创建新的采购订单",
      "type": "CREATE",
      "requiredPermissions": ["PURCHASE_ORDER_CREATE"],
      "transactional": true,
      "parameters": [
        {
          "name": "orderData",
          "type": "OBJECT",
          "required": true,
          "description": "订单数据",
          "schemaRef": "#/definitions/PurchaseOrderCreateRequest"
        }
      ],
      "returnType": {
        "type": "OBJECT",
        "description": "创建的采购订单",
        "schemaRef": "#"
      },
      "preconditions": [
        {
          "expression": "orderData.supplierId != null",
          "errorMessage": "供应商ID不能为空"
        },
        {
          "expression": "hasPermission(currentUser, 'PURCHASE_ORDER_CREATE')",
          "errorMessage": "没有创建采购订单的权限"
        }
      ],
      "steps": [
        {
          "name": "generateOrderId",
          "type": "CALCULATION",
          "parameters": {
            "pattern": "PO-{{YYYYMMDD}}-{{seq}}"
          },
          "order": 1
        },
        {
          "name": "validateData",
          "type": "CALCULATION",
          "parameters": {
            "validator": "purchaseOrderValidator"
          },
          "order": 2
        },
        {
          "name": "saveOrder",
          "type": "DATA_CREATE",
          "parameters": {
            "entity": "PurchaseOrder",
            "fields": "*"
          },
          "order": 3
        },
        {
          "name": "saveDetails",
          "type": "DATA_CREATE",
          "parameters": {
            "entity": "PurchaseOrderDetail",
            "parentField": "purchaseOrderId"
          },
          "order": 4
        },
        {
          "name": "logActivity",
          "type": "SERVICE_CALL",
          "parameters": {
            "service": "activityLogger",
            "method": "logCreate"
          },
          "order": 5,
          "continueOnError": true
        }
      ],
      "audited": true,
      "async": false
    },
    "submitForApproval": {
      "name": "submitForApproval",
      "label": "提交审批",
      "description": "提交采购订单进行审批",
      "type": "WORKFLOW",
      "requiredPermissions": ["PURCHASE_ORDER_SUBMIT"],
      "transactional": true,
      "parameters": [
        {
          "name": "orderId",
          "type": "TEXT",
          "required": true,
          "description": "订单ID"
        }
      ],
      "returnType": {
        "type": "OBJECT",
        "description": "操作结果",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "approvalProcessId": { "type": "string" }
        }
      },
      "preconditions": [
        {
          "expression": "order.status == 'DRAFT'",
          "errorMessage": "只有草稿状态的订单可以提交审批"
        },
        {
          "expression": "hasPermission(currentUser, 'PURCHASE_ORDER_SUBMIT')",
          "errorMessage": "没有提交审批的权限"
        }
      ],
      "steps": [
        {
          "name": "startApprovalProcess",
          "type": "SERVICE_CALL",
          "parameters": {
            "service": "workflowService",
            "method": "startProcess",
            "processKey": "purchaseOrderApprovalProcess"
          },
          "order": 1
        },
        {
          "name": "updateOrderStatus",
          "type": "DATA_UPDATE",
          "parameters": {
            "entity": "PurchaseOrder",
            "fields": {
              "status": "SUBMITTED",
              "approvalProcessId": "{{approvalProcessId}}"
            }
          },
          "order": 2
        },
        {
          "name": "notifyApprovers",
          "type": "SERVICE_CALL",
          "parameters": {
            "service": "notificationService",
            "method": "sendApprovalNotification"
          },
          "order": 3,
          "continueOnError": true
        }
      ],
      "audited": true,
      "async": false
    }
  },
  "indexes": [
    {
      "name": "idx_purchase_order_status",
      "type": "BTREE",
      "fields": ["status"],
      "unique": false,
      "description": "订单状态索引"
    },
    {
      "name": "idx_purchase_order_supplier",
      "type": "BTREE",
      "fields": ["supplierId"],
      "unique": false,
      "description": "供应商索引"
    },
    {
      "name": "idx_purchase_order_delivery_date",
      "type": "BTREE",
      "fields": ["deliveryDate"],
      "unique": false,
      "description": "交货日期索引"
    },
    {
      "name": "idx_purchase_order_composite",
      "type": "COMPOSITE",
      "fields": ["department", "status", "createdAt"],
      "unique": false,
      "orderDirections": ["ASC", "ASC", "DESC"],
      "description": "复合索引用于报表查询"
    }
  ],
  "permissions": {
    "readPermissions": ["PURCHASE_ORDER_READ", "ADMIN"],
    "createPermissions": ["PURCHASE_ORDER_CREATE", "ADMIN"],
    "updatePermissions": ["PURCHASE_ORDER_UPDATE", "ADMIN"],
    "deletePermissions": ["PURCHASE_ORDER_DELETE", "ADMIN"],
    "operationPermissions": {
      "submitForApproval": ["PURCHASE_ORDER_SUBMIT", "ADMIN"],
      "cancelOrder": ["PURCHASE_ORDER_CANCEL", "ADMIN"],
      "approveOrder": ["PURCHASE_ORDER_APPROVE", "ADMIN"]
    },
    "defaultAccessLevel": "PROTECTED"
  },
  "aiEnhancement": {
    "enabled": true,
    "autoClassification": true,
    "entityRecommendations": true,
    "ruleOptimization": true,
    "anomalyDetection": true,
    "predictionModels": [
      {
        "name": "deliveryDatePrediction",
        "modelType": "TIME_SERIES",
        "targetField": "deliveryDate",
        "featureFields": ["supplierId", "orderType", "totalAmount", "department"],
        "confidenceThreshold": 0.85,
        "enabled": true
      },
      {
        "name": "supplierRecommendation",
        "modelType": "COLLABORATIVE_FILTERING",
        "targetField": "supplierId",
        "featureFields": ["department", "details.productId", "totalAmount"],
        "confidenceThreshold": 0.7,
        "enabled": true
      }
    ]
  },
  "kgConfig": {
    "enabled": true,
    "entityMappings": [
      {
        "entityType": "PurchaseOrder",
        "kgNodeType": "采购订单",
        "idField": "id",
        "labelField": "id",
        "propertyMappings": [
          { "sourceField": "orderType", "targetProperty": "订单类型", "dataType": "string" },
          { "sourceField": "totalAmount", "targetProperty": "订单金额", "dataType": "double" },
          { "sourceField": "status", "targetProperty": "订单状态", "dataType": "string" }
        ]
      }
    ],
    "relationshipMappings": [
      {
        "relationshipType": "orderDetails",
        "kgRelationshipType": "包含",
        "sourceEntityType": "PurchaseOrder",
        "targetEntityType": "PurchaseOrderDetail",
        "propertyMappings": []
      },
      {
        "relationshipType": "supplier",
        "kgRelationshipType": "向...采购",
        "sourceEntityType": "PurchaseOrder",
        "targetEntityType": "Supplier",
        "propertyMappings": [
          { "sourceField": "createdAt", "targetProperty": "采购时间", "dataType": "datetime" }
        ]
      }
    ]
  },
  "mcpInterface": {
    "dataIngestion": "/api/mcp/v1/purchase-order/ingest",
    "metadataTagging": "/api/mcp/v1/purchase-order/tag",
    "interoperability": "/api/mcp/v1/purchase-order/interop"
  },
  "extensions": {
    "reportable": true,
    "exportable": true,
    "mobileEnabled": true,
    "notificationEnabled": true
  }
}