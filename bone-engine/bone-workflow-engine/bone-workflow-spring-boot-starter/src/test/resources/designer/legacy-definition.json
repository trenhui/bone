{
  "key": "legacy_demo",
  "name": "存量定义（无 ui 段）",
  "version": 1,
  "engineSchemaVersion": 1,
  "nodes": [
    { "code": "start", "type": "START", "label": "发起" },
    { "code": "cond", "type": "CONDITION", "label": "金额判断" },
    { "code": "mgr", "type": "APPROVE", "mode": "SINGLE", "label": "直属主管" },
    { "code": "cfo", "type": "APPROVE", "mode": "SINGLE", "label": "财务总监" },
    { "code": "end", "type": "END", "label": "结束" }
  ],
  "edges": [
    { "from": "start", "to": "cond" },
    {
      "from": "cond",
      "to": "cfo",
      "when": { "fieldCode": "amount", "operator": "gt", "value": 10000 },
      "label": "大额"
    },
    { "from": "cond", "to": "mgr", "when": null, "label": "默认" },
    { "from": "mgr", "to": "end" },
    { "from": "cfo", "to": "end" }
  ],
  "assignments": {
    "mgr": [{ "strategy": "LINE_MANAGER", "params": {} }],
    "cfo": [{ "strategy": "ROLE", "params": { "roleCode": "cfo" } }]
  }
}
