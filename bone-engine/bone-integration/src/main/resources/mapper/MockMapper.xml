<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bone.integration.infrastructure.mapper.MockMapper" >
<!-- ApiResponse Map-->
<resultMap id="BaseResultMap" type="com.bone.integration.domain.model.MockDO" >
	<result column="id" property="id"/>
	<result column="name" property="name"/>
	<result column="mock_key" property="mockKey"/>
	<result column="app_code" property="appCode"/>
	<result column="conditions" property="conditions"/>
	<result column="remark" property="remark"/>
	<result column="deleted" property="deleted"/>
	<result column="created_at" property="createdAt"/>
	<result column="created_by" property="createdBy"/>
	<result column="updated_at" property="updatedAt"/>
	<result column="updated_by" property="updatedBy"/>
</resultMap>

<sql id="Example_Where_Clause">
	where 1=1 and deleted=0
	<if test="name != null and name != ''">
		and name like concat("%", #{name}, "%")
	</if>
	<if test="appCode != null and appCode != ''">
		and app_code = #{appCode}
	</if>
</sql>
       
<!-- t_object table all fields -->
<sql id="Base_Column_List" >
	id, app_code, name, mock_key, url, conditions, remark, created_at, created_by, updated_at, updated_by, deleted
</sql>

<insert id="add" parameterType="com.bone.integration.domain.model.MockDO" >
	insert into t_mock (id, app_code, name, mock_key, url, conditions, remark, deleted, created_at, created_by, updated_at, updated_by)
	values (#{id},#{appCode},#{name},#{mockKey},#{url},#{conditions},#{remark},0,now(),#{createdBy},now(),#{updatedBy});
</insert>

<delete id="deleteById" parameterType="java.lang.Long">
 delete from t_mock where id=#{id}
</delete>

<update id="update" parameterType="com.bone.integration.domain.model.MockDO" >
	update t_mock set
	<trim  suffixOverrides="," >
		<if test="name != null and name != ''">
			name=#{name},
		</if>
		<if test="mockKey != null and mockKey != ''">
			mock_key=#{mockKey},
		</if>
		<if test="appCode != null and appCode != ''">
			app_code=#{appCode},
		</if>
		<if test="url != null and url != ''">
			url=#{url},
		</if>
		<if test="conditions != null and conditions != ''">
			conditions=#{conditions},
		</if>
		<if test="remark != null and remark != ''">
			remark=#{remark},
		</if>
		<if test="deleted != null">
			deleted=#{deleted},
		</if>
		<if test="createdAt != null">
			created_at=#{createdAt},
		</if>
		<if test="createdBy != null">
			created_by=#{createdBy},
		</if>
		updated_at=now(),
		<if test="updatedBy != null">
			updated_by=#{updatedBy},
		</if>
	</trim> where id=#{id}
</update>

<select id="getById" resultMap="BaseResultMap" parameterType="java.lang.Long">
	select <include refid="Base_Column_List" />
	from t_mock where id = #{id}
</select>

<select id="getByMockKey" resultMap="BaseResultMap" parameterType="java.lang.String">
	select <include refid="Base_Column_List" />
	from t_mock where mock_key = #{mockKey}
</select>

<select id="queryListCount" resultType="java.lang.Long" parameterType="com.bone.integration.domain.model.MockDO">
	select count(*)
	from t_mock
	<include refid="Example_Where_Clause"/>
</select>

<select id="queryByList" resultMap="BaseResultMap" parameterType="com.bone.integration.domain.model.MockDO">
	select <include refid="Base_Column_List" />
	from t_mock
	<include refid="Example_Where_Clause"/>
	order by updated_at desc
</select>

</mapper>   
