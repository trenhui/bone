<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-metadata-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../bone-engine/bone-metadata-engine/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>bone-boot</artifactId>
    <name>bone-boot</name>
    <description>组装引导组合根（部署装配）：聚合 bone-metadata-server + 各业务应用模块（报销/会计/采购）。
        业务应用以 Spring Boot 自动配置（autoconfiguration）形式挂入 classpath，server 自身保持纯平台、不反向依赖任何业务模块。</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 业务应用模块：以 autoconfiguration 形式自动装配，无需 server 反向依赖 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-app-expense</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-accounting-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-app-purchase</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <version>${bone-architecture-test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.bone.boot.BoneBootApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
