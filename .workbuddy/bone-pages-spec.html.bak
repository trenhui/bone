<!-- ═══════════════ 7. GENERATOR ═══════════════ -->
<template id="tpl-generator">
  <p class="page-desc">Studio Generator — 基于元数据与 <b>FreeMarker</b> 模板生成对齐 <b>Bone-DDD</b> 的 Java 代码。<b>CATALOG_SNAPSHOT</b> 只读已发布 (status=1) meta_entity。<b>Monaco Editor</b> 编辑模板，<b>LRO 异步任务</b> 202+轮询。</p>

  <div class="spec-panel">
    <div class="spec-row">
      <div class="spec-item"><span class="spec-key">API 前缀</span><span class="spec-val">/api/v1/generator</span></div>
      <div class="spec-item"><span class="spec-key">默认端口</span><span class="spec-val">8085</span></div>
      <div class="spec-item"><span class="spec-key">前端</span><span class="spec-val">bone-generator-app :3009</span></div>
      <div class="spec-item"><span class="spec-key">编辑器</span><span class="spec-val">Monaco 0.44+</span></div>
    </div>
    <div class="spec-row" style="margin-top:4px">
      <div class="spec-item"><span class="spec-key">状态管理</span><span class="spec-val">Zustand 4.4+</span></div>
      <div class="spec-item"><span class="spec-key">异步数据</span><span class="spec-val">React Query 5.0+</span></div>
      <div class="spec-item"><span class="spec-key">LRO</span><span class="spec-val">202 + GET /operations/{taskId}</span></div>
    </div>
  </div>

  <div class="tabs" id="gen-tabs">
    <button class="tab active" data-gen="datasource">🗄 数据源管理</button>
    <button class="tab" data-gen="codegen">&lt;/&gt; 代码生成</button>
    <button class="tab" data-gen="templates">📝 模板管理</button>
    <button class="tab" data-gen="history">📜 生成历史</button>
  </div>

  <!-- Data Source -->
  <div id="gen-datasource">
    <div class="toolbar"><div class="toolbar-l"><button class="btn btn-p">+ 新建数据源</button></div></div>
    <div class="card" style="padding:0;overflow:hidden">
      <table><thead><tr><th>名称</th><th>类型</th><th>主机:端口</th><th>库名</th><th>状态</th><th>最后测试</th><th>操作</th></tr></thead><tbody>
        <tr><td style="font-weight:500">开发库</td><td>MySQL</td><td style="font-family:monospace;font-size:11px">192.168.1.50:3306</td><td>bone_dev</td><td><span class="tag tag-ok">启用</span></td><td style="color:var(--tt);font-size:11px">14:30 · SUCCESS</td><td><button class="btn btn-l btn-sm">测试连接</button><button class="btn btn-l btn-sm">编辑</button><button class="btn btn-l btn-sm" style="color:var(--err)">删除</button></td></tr>
        <tr><td style="font-weight:500">生产库 (只读)</td><td>PostgreSQL</td><td style="font-family:monospace;font-size:11px">pg-prod.internal:5432</td><td>bone_prod</td><td><span class="tag tag-ok">启用</span></td><td style="color:var(--tt);font-size:11px">12:00 · SUCCESS</td><td><button class="btn btn-l btn-sm">测试连接</button><button class="btn btn-l btn-sm">编辑</button></td></tr>
      </tbody></table>
    </div>
  </div>

  <!-- Code Generation -->
  <div id="gen-codegen" style="display:none"></div>
  <div id="gen-templates" style="display:none"></div>
  <div id="gen-history" style="display:none"></div>
</template>

<template id="tpl-gen-codegen">
  <div class="card-grid-2">
    <div class="card">
      <div class="card-title">📋 选择实体 (CATALOG_SNAPSHOT · 仅 status=1)</div>
      <div class="fg"><label>业务实体</label><select><option>客户信息 (GENERATIVE, status=1, 12 字段)</option><option>供应商 (GENERATIVE, status=1, 8 字段)</option><option>产品目录 (GENERATIVE, status=1, 15 字段)</option></select></div>
      <div class="fg"><label>前端模板</label><select><option>React 18 + Ant Design 5.12</option><option>Vue 3 + Element Plus</option></select></div>
      <div class="fg"><label>后端模板</label><select><option>Spring Boot 3.2 + Bone SDK</option></select></div>
      <div class="fg-row">
        <div class="fg"><label>项目名 <span class="req">*</span></label><input value="bone-order"></div>
        <div class="fg"><label>基础包路径 <span class="req">*</span></label><input value="com.bone.order"></div>
        <div class="fg"><label>模块名 <span class="req">*</span></label><input value="order"></div>
      </div>
      <button class="btn btn-p" style="width:100%;margin-top:8px">&lt;/&gt; 生成代码 (202 + LRO)</button>

      <!-- LRO progress mock -->
      <div class="lro-bar" style="margin-top:12px">
        <div class="dot"></div>
        <div class="msg">生成中: 客户信息</div>
        <div class="lro-progress"><div class="lro-fill" style="width:80%"></div></div>
        <div class="detail">80% · EntityGenerated → Repository → Controller...</div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">📦 生成产物预览</div>
      <div style="font-size:12px;color:var(--ts);margin-bottom:8px">包路径: com.bone.order</div>
      <div style="font-size:12px;line-height:2;color:var(--ts)">
        <div>📁 domain/customer/</div>
        <div style="padding-left:16px">📄 Customer.java</div>
        <div style="padding-left:16px">📄 CustomerId.java</div>
        <div>📁 domain/repository/</div>
        <div style="padding-left:16px">📄 CustomerRepository.java</div>
        <div>📁 application/command/handler/</div>
        <div style="padding-left:16px">📄 CreateCustomerCommandHandler.java</div>
        <div>📁 adapter/web/controller/</div>
        <div style="padding-left:16px">📄 CustomerController.java</div>
        <div style="font-weight:600;color:var(--p);margin-top:8px">⛔ 禁止: persistence/ · RepositoryImpl · MyBatis Mapper</div>
      </div>
    </div>
  </div>
</template>

<template id="tpl-gen-templates">
  <div class="toolbar"><div class="toolbar-l"><button class="btn btn-p">+ 新建模板</button></div></div>
  <div class="card" style="padding:0;overflow:hidden">
    <table><thead><tr><th>模板名称</th><th>编码</th><th>类型</th><th>引擎</th><th>版本</th><th>状态</th><th>操作</th></tr></thead><tbody>
      <tr><td style="font-weight:500">Entity 聚合根</td><td style="font-family:monospace;font-size:11px">entity</td><td><span class="tag tag-i">entity</span></td><td>Freemarker</td><td>v2.1.0</td><td><span class="tag tag-ok">已发布</span></td><td><button class="btn btn-l btn-sm">预览</button><button class="btn btn-l btn-sm">编辑</button></td></tr>
      <tr><td style="font-weight:500">Repository 空接口</td><td style="font-family:monospace;font-size:11px">repository</td><td><span class="tag tag-i">repository</span></td><td>Freemarker</td><td>v1.5.0</td><td><span class="tag tag-ok">已发布</span></td><td><button class="btn btn-l btn-sm">预览</button><button class="btn btn-l btn-sm">编辑</button></td></tr>
      <tr><td style="font-weight:500">CommandHandler</td><td style="font-family:monospace;font-size:11px">cmd-handler</td><td><span class="tag tag-i">handler</span></td><td>Freemarker</td><td>v1.4.2</td><td><span class="tag tag-ok">已发布</span></td><td><button class="btn btn-l btn-sm">预览</button><button class="btn btn-l btn-sm">编辑</button></td></tr>
    </tbody></table>
  </div>

  <!-- Monaco Editor Mock -->
  <div class="card" style="margin-top:16px">
    <div class="card-title">📝 模板编辑器 (Monaco Editor 0.44+)</div>
    <div class="monaco-mock">
      <div class="mh">
        <span class="tab-item act">Entity.ftl</span>
        <span class="tab-item">Repository.ftl</span>
      </div>
      <div class="mb">
        <span class="kw">package</span> ${basePackage}.domain.${moduleName};<br><br>
        <span class="kw">import</span> com.bone.core.domain.AggregateRoot;<br>
        <span class="kw">import</span> lombok.Getter;<br><br>
        <span class="ann">@Getter</span><br>
        <span class="kw">public class</span> ${entityName} <span class="kw">extends</span> AggregateRoot&lt;Long&gt; {<br>
        &nbsp;&nbsp;<span class="kw">private</span> Long id;<br>
        <span class="cmt">&nbsp;&nbsp;// Generated from table: ${table.name}</span><br>
        <span class="mlh">&lt;#list table.columns as col&gt;</span><br>
        &nbsp;&nbsp;<span class="kw">private</span> ${col.javaType} ${col.fieldName};<br>
        <span class="mlh">&lt;/#list&gt;</span><br>
        }
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:12px;justify-content:flex-end">
      <button class="btn btn-d btn-sm">预览渲染</button>
      <button class="btn btn-d btn-sm">语法校验</button>
      <button class="btn btn-p btn-sm">保存模板</button>
    </div>
  </div>
</template>

