<!DOCTYPE html>
<html lang="zh-CN" data-bone-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BONE · 8 项菜单页面视觉稿 & 交互规范 v3.5</title>
<style>
/* ============================================================
   Design Tokens — 对齐 @bone/ui + Ant Design 5.12+
   ============================================================ */
:root,[data-bone-theme="light"]{
  --p:#1677FF;--ph:#4096FF;--pa:#0958D9;--pb:#E6F4FF;
  --bl:#F5F5F5;--bc:#FFFFFF;--be:#FAFAFA;
  --t:#262626;--ts:#595959;--tt:#8C8C8C;--td:#BFBFBF;
  --b:#D9D9D9;--bs:#F0F0F0;--d:#F0F0F0;
  --suc:#52C41A;--sucb:#F6FFED;--war:#FA8C16;--warb:#FFF7E6;--err:#FF4D4F;--errb:#FFF2F0;
  --sh:0 1px 2px rgba(0,0,0,.06);--sm:0 4px 12px rgba(0,0,0,.08);--sl:0 8px 24px rgba(0,0,0,.12);
  --r:6px;--rl:8px;--rs:4px;
}
[data-bone-theme="dark"]{
  --p:#4096FF;--ph:#69B1FF;--pa:#1677FF;--pb:rgba(64,150,255,.12);
  --bl:#000000;--bc:#141414;--be:#1F1F1F;
  --t:rgba(255,255,255,.88);--ts:rgba(255,255,255,.65);--tt:rgba(255,255,255,.45);--td:rgba(255,255,255,.25);
  --b:#424242;--bs:#303030;--d:rgba(255,255,255,.08);
  --suc:#73D13D;--sucb:rgba(82,196,26,.12);--war:#FFC53D;--warb:rgba(250,140,22,.12);--err:#FF7875;--errb:rgba(255,77,79,.12);
  --sh:0 1px 2px rgba(0,0,0,.2);--sm:0 4px 12px rgba(0,0,0,.3);--sl:0 8px 24px rgba(0,0,0,.4);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;font-size:14px;color:var(--t);background:var(--bl);line-height:1.5715;-webkit-font-smoothing:antialiased;height:100vh;overflow:hidden}
#app{display:flex;height:100vh}

/* ── Sidebar ──────────────────────────────────────────── */
.sider{width:240px;background:var(--bc);border-right:1px solid var(--bs);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden;transition:width .2s}
.sider-logo{height:56px;display:flex;align-items:center;padding:0 20px;border-bottom:1px solid var(--bs);gap:10px}
.sider-logo .icon{width:32px;height:32px;background:var(--p);border-radius:var(--r);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:15px;flex-shrink:0}
.sider-logo .text{font-size:15px;font-weight:600;color:var(--t);white-space:nowrap;display:flex;flex-direction:column}
.sider-logo .text .sub{font-size:10px;color:var(--tt);font-weight:400}
.sider-nav{flex:1;padding:8px;overflow-y:auto}
.nav-section{font-size:11px;color:var(--tt);padding:14px 12px 6px;text-transform:uppercase;letter-spacing:.6px;font-weight:500}
.nav-item{display:flex;align-items:center;height:40px;padding:0 12px;margin:2px 0;border-radius:var(--r);color:var(--ts);cursor:pointer;transition:all .15s;gap:10px;font-size:13px;border:none;background:none;width:100%;text-align:left;font-family:inherit}
.nav-item:hover{background:var(--bs);color:var(--t)}
.nav-item.active{background:var(--pb);color:var(--p);font-weight:500}
.nav-item .ico{font-size:15px;width:16px;text-align:center;flex-shrink:0}
.sider-theme{height:48px;display:flex;align-items:center;justify-content:center;border-top:1px solid var(--bs);gap:8px}
.sider-theme button{width:36px;height:22px;background:var(--b);border-radius:11px;border:none;cursor:pointer;position:relative;transition:background .2s}
.sider-theme button::after{content:'';position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:3px;left:3px;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
[data-bone-theme="dark"] .sider-theme button{background:var(--p)}
[data-bone-theme="dark"] .sider-theme button::after{transform:translateX(14px)}

/* ── Main ─────────────────────────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden}
.header{height:56px;background:var(--bc);border-bottom:1px solid var(--bs);display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex-shrink:0}
.header-left{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--ts)}
.header-left .page-title{font-weight:600;color:var(--t);font-size:16px}
.header-right{display:flex;align-items:center;gap:4px}
.header-btn{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:none;background:transparent;color:var(--ts);border-radius:var(--r);cursor:pointer;font-size:15px;transition:all .15s}
.header-btn:hover{background:var(--bs);color:var(--t)}
.user-badge{display:flex;align-items:center;gap:8px;padding:2px 8px;border-radius:var(--r);cursor:pointer;margin-left:4px;font-size:13px}
.user-badge:hover{background:var(--bs)}
.user-badge .avatar{width:28px;height:28px;border-radius:50%;background:var(--b);display:flex;align-items:center;justify-content:center;font-size:13px;color:var(--ts)}

/* ── Content ──────────────────────────────────────────── */
.content{flex:1;overflow-y:auto;padding:24px}
.page-desc{color:var(--tt);font-size:13px;margin-bottom:20px;max-width:720px;line-height:1.7}
.page-desc b{color:var(--t)}

/* ── Cards ────────────────────────────────────────────── */
.card{background:var(--bc);border:1px solid var(--bs);border-radius:var(--rl);padding:20px;box-shadow:var(--sh);margin-bottom:16px}
.card-title{font-size:15px;font-weight:600;color:var(--t);margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--bs)}
.card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
.card-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.card-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}

/* ── Stat Cards ───────────────────────────────────────── */
.stat{background:var(--bc);border:1px solid var(--bs);border-radius:var(--r);padding:16px 20px;transition:all .2s;cursor:pointer;position:relative;overflow:hidden}
.stat:hover{box-shadow:var(--sm);border-color:var(--p)}
.stat::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:transparent;transition:background .2s}
.stat:nth-child(1):hover::after{background:var(--p)}
.stat:nth-child(2):hover::after{background:var(--suc)}
.stat:nth-child(3):hover::after{background:var(--war)}
.stat:nth-child(4):hover::after{background:var(--err)}
.stat-label{font-size:12px;color:var(--tt);margin-bottom:8px}
.stat-val{font-size:28px;font-weight:600;color:var(--t);line-height:1}
.stat-delta{font-size:12px;margin-top:6px}
.stat-delta.up{color:var(--err)}
.stat-delta.down{color:var(--suc)}

/* ── Buttons ──────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 15px;font-size:14px;font-family:inherit;border-radius:var(--r);border:1px solid transparent;cursor:pointer;transition:all .15s;white-space:nowrap;font-weight:400}
.btn-sm{height:26px;padding:0 10px;font-size:12px;border-radius:var(--rs)}
.btn-p{background:var(--p);border-color:var(--p);color:#fff}
.btn-p:hover{background:var(--ph);border-color:var(--ph)}
.btn-d{background:var(--bc);border-color:var(--b);color:var(--t)}
.btn-d:hover{color:var(--p);border-color:var(--p)}
.btn-t{background:transparent;border-color:transparent;color:var(--ts)}
.btn-t:hover{background:var(--bs);color:var(--t)}
.btn-l{background:transparent;border-color:transparent;color:var(--p);padding:0 4px;height:auto}
.btn-l:hover{color:var(--ph)}
.btn-e{background:var(--err);border-color:var(--err);color:#fff}

/* ── Tabs ─────────────────────────────────────────────── */
.tabs{display:flex;gap:0;border-bottom:2px solid var(--bs);margin-bottom:20px}
.tab{padding:8px 16px;font-size:14px;color:var(--ts);cursor:pointer;border:none;background:none;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s;font-weight:400}
.tab:hover{color:var(--p)}
.tab.active{color:var(--p);border-bottom-color:var(--p);font-weight:500}

/* ── Toolbar ──────────────────────────────────────────── */
.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px}
.toolbar-l{display:flex;gap:8px;align-items:center}
.toolbar-r{display:flex;gap:8px;align-items:center}

/* ── Search ───────────────────────────────────────────── */
.search-box{display:flex;align-items:center;gap:0}
.search-box input{height:32px;padding:0 11px;font-size:14px;font-family:inherit;color:var(--t);background:var(--bc);border:1px solid var(--b);border-right:none;border-radius:var(--r) 0 0 var(--r);outline:none;width:200px;transition:border-color .15s}
.search-box input:focus{border-color:var(--p)}
.search-box button{height:32px;padding:0 12px;background:var(--bc);border:1px solid var(--b);border-radius:0 var(--r) var(--r) 0;cursor:pointer;color:var(--ts);font-size:14px;display:flex;align-items:center}
.search-box button:hover{color:var(--p);border-color:var(--p)}

/* ── Table ────────────────────────────────────────────── */
table{width:100%;border-collapse:collapse;font-size:13px}
thead th{background:var(--bs);padding:9px 14px;text-align:left;font-weight:500;color:var(--ts);border-bottom:1px solid var(--b);white-space:nowrap;font-size:12px}
tbody td{padding:10px 14px;border-bottom:1px solid var(--bs);color:var(--t)}
tbody tr:hover{background:var(--pb)}
.table-actions{display:flex;gap:6px}
tr:nth-child(even){background:var(--be)}

/* ── Tags ─────────────────────────────────────────────── */
.tag{display:inline-block;font-size:11px;line-height:20px;padding:0 7px;border-radius:var(--rs);font-weight:400}
.tag-ok{background:var(--sucb);color:var(--suc)}
.tag-w{background:var(--warb);color:var(--war)}
.tag-e{background:var(--errb);color:var(--err)}
.tag-i{background:var(--pb);color:var(--p)}
.tag-d{background:var(--bs);color:var(--ts)}

/* ── Pagination ───────────────────────────────────────── */
.pag{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:16px;font-size:13px}
.pag-info{color:var(--ts);margin-right:8px}
.pag-item{min-width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--b);border-radius:var(--r);background:var(--bc);color:var(--t);cursor:pointer;font-size:13px}
.pag-item:hover{color:var(--p);border-color:var(--p)}
.pag-item.act{background:var(--p);border-color:var(--p);color:#fff}

/* ── Form Elements ────────────────────────────────────── */
.fg{margin-bottom:14px}
.fg label{display:block;font-size:13px;color:var(--t);margin-bottom:5px;font-weight:500}
.fg label .req{color:var(--err)}
.fg input,.fg select,.fg textarea{display:block;width:100%;height:32px;padding:0 11px;font-size:13px;font-family:inherit;color:var(--t);background:var(--bc);border:1px solid var(--b);border-radius:var(--r);outline:none;transition:border-color .15s}
.fg input:focus,.fg select:focus{border-color:var(--p);box-shadow:0 0 0 2px rgba(22,119,255,.12)}
.fg select{appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%238C8C8C' stroke-width='1.5' fill='none'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 11px center;padding-right:28px}
.fg .help{font-size:12px;margin-top:4px;color:var(--tt)}
.fg textarea{height:80px;padding:8px 11px;resize:vertical}
.fg-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.fg-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}

/* ── Interaction Diagram ──────────────────────────────── */
.interact-box{background:var(--bl);border:1px dashed var(--b);border-radius:var(--rl);padding:20px;margin-top:16px;margin-bottom:16px}
.interact-title{font-weight:600;font-size:13px;color:var(--t);margin-bottom:10px}
.interact-flow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:13px}
.interact-step{background:var(--bc);border:1px solid var(--b);border-radius:var(--r);padding:10px 14px;white-space:nowrap;font-weight:500;color:var(--t)}
.interact-step.key{background:var(--pb);border-color:var(--p);color:var(--p)}
.interact-arrow{color:var(--tt);font-size:16px;font-weight:700}
.interact-note{font-size:12px;color:var(--tt);margin-top:12px;line-height:1.7}
.interact-note b{color:var(--t)}

/* ── Modal inline ─────────────────────────────────────── */
.modal-inline{border:1px dashed var(--b);border-radius:var(--rl);overflow:hidden;background:var(--bl)}
.modal-inline .mh{padding:14px 20px;border-bottom:1px solid var(--bs);font-weight:600;font-size:15px;color:var(--t);display:flex;justify-content:space-between;align-items:center;background:var(--bc)}
.modal-inline .mb{padding:20px;background:var(--bc)}
.modal-inline .mf{padding:12px 20px;border-top:1px solid var(--bs);display:flex;justify-content:flex-end;gap:8px;background:var(--bc)}

/* ── State Machine Diagram ────────────────────────────── */
.state-machine{display:flex;align-items:center;gap:0;padding:24px 16px;justify-content:center;flex-wrap:wrap;overflow-x:auto}
.state-node{min-width:80px;height:48px;background:var(--bc);border:2px solid var(--b);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--ts);font-weight:500;padding:0 8px}
.state-node.uploaded{border-color:var(--p);color:var(--p);background:var(--pb)}
.state-node.validated{border-color:var(--suc);color:var(--suc);background:var(--sucb)}
.state-node.active{border-color:#722ED1;color:#722ED1;background:rgba(114,46,209,.08)}
.state-node.deprecated{border-color:var(--tt);color:var(--tt)}
.state-arrow{min-width:24px;height:2px;background:var(--b);position:relative;margin:0 2px}
.state-arrow::after{content:'▶';position:absolute;right:-6px;top:-7px;font-size:9px;color:var(--b)}

/* ── Dependency Graph Mini ────────────────────────────── */
.dep-graph{padding:24px;display:flex;flex-wrap:wrap;gap:16px;justify-content:center;align-items:center}
.dep-node{background:var(--bc);border:2px solid var(--b);border-radius:var(--rl);padding:12px 18px;font-size:12px;font-weight:500;color:var(--t);text-align:center;cursor:pointer;transition:all .15s}
.dep-node:hover{border-color:var(--p);box-shadow:var(--sm)}
.dep-node .plugin-id{font-family:monospace;font-size:10px;color:var(--tt);margin-top:2px}
.dep-edge{display:flex;align-items:center;font-size:20px;color:var(--tt)}

/* ── Flow Designer Mini ───────────────────────────────── */
.flow-mini{display:flex;align-items:center;gap:20px;padding:24px;justify-content:center;flex-wrap:wrap}
.flow-node{width:100px;height:48px;background:var(--bc);border:2px solid var(--b);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--ts);font-weight:500}
.flow-node.start{border-color:var(--suc);color:var(--suc)}
.flow-node.end{border-color:var(--err);color:var(--err)}
.flow-node.http{border-color:var(--p);color:var(--p)}
.flow-arrow-h{width:30px;height:2px;background:var(--b);position:relative}
.flow-arrow-h::after{content:'▶';position:absolute;right:-6px;top:-7px;font-size:10px;color:var(--b)}

/* ── LRO Progress ─────────────────────────────────────── */
.lro-bar{display:flex;align-items:center;gap:12px;padding:16px 20px;background:var(--pb);border-radius:var(--r);margin-top:16px}
.lro-bar .dot{width:8px;height:8px;background:var(--p);border-radius:50%;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.lro-bar .msg{font-size:13px;color:var(--p);font-weight:500}
.lro-bar .detail{font-size:12px;color:var(--tt)}
.lro-bar .lro-progress{flex:1;height:4px;background:var(--bs);border-radius:2px;overflow:hidden}
.lro-bar .lro-fill{height:100%;background:var(--p);border-radius:2px;transition:width .5s;width:65%}

/* ── Monaco Editor Mock ────────────────────────────────── */
.monaco-mock{background:#1E1E1E;border-radius:var(--r);overflow:hidden;font-family:"Fira Code","Cascadia Code",monospace}
.monaco-mock .mh{background:#2D2D2D;padding:6px 12px;display:flex;gap:8px}
.monaco-mock .mh .tab-item{padding:4px 12px;font-size:12px;color:#858585;cursor:pointer;border-radius:3px 3px 0 0}
.monaco-mock .mh .tab-item.act{background:#1E1E1E;color:#CCCCCC}
.monaco-mock .mb{padding:12px 16px;font-size:13px;line-height:1.8;color:#D4D4D4}
.monaco-mock .mb .kw{color:#569CD6}.monaco-mock .mb .str{color:#CE9178}.monaco-mock .mb .cmt{color:#6A9955}.monaco-mock .mb .ann{color:#C586C0}
.monaco-mock .mlh{color:#858585}

/* ── Connector Cards ──────────────────────────────────── */
.conn-card{background:var(--bc);border:1px solid var(--bs);border-radius:var(--rl);padding:14px 16px;cursor:pointer;transition:all .2s;display:flex;flex-direction:column;gap:4px}
.conn-card:hover{box-shadow:var(--sm);border-color:var(--p)}
.conn-card .cc-icon{font-size:28px}
.conn-card .cc-name{font-weight:600;font-size:14px;color:var(--t)}
.conn-card .cc-type{font-size:11px;color:var(--tt)}
.conn-card .cc-status{margin-top:6px}

/* ── Spec Panel ───────────────────────────────────────── */
.spec-panel{background:var(--pb);border:1px solid var(--p);border-radius:var(--r);padding:12px 16px;margin-bottom:16px;font-size:12px;line-height:1.7}
.spec-panel .spec-row{display:flex;gap:20px;flex-wrap:wrap}
.spec-panel .spec-item{display:flex;gap:4px}
.spec-panel .spec-key{color:var(--p);font-weight:600}
.spec-panel .spec-val{color:var(--t);font-family:monospace}

/* ── Responsive ───────────────────────────────────────── */
@media(max-width:768px){.card-grid-2,.card-grid-3,.card-grid-4{grid-template-columns:1fr}}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--b);border-radius:2px}

/* ── Section Header ────────────────────────────────────── */
.section-header{font-size:13px;font-weight:600;color:var(--t);margin:24px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--bs)}
.section-header:first-child{margin-top:0}
</style>
</head>
<body>
<div id="app">

<!-- Sidebar -->
<aside class="sider">
  <div class="sider-logo">
    <div class="icon">B</div>
    <span class="text">Bone Admin<span class="sub">企业级快速开发平台</span></span>
  </div>
  <nav class="sider-nav" id="nav">
    <div class="nav-section">主菜单</div>
    <button class="nav-item active" data-page="dashboard"><span class="ico">⌂</span> 首页仪表盘</button>
    <button class="nav-item" data-page="iam"><span class="ico">👤</span> IAM 管理</button>
    <button class="nav-item" data-page="metadata"><span class="ico">🗄</span> 元数据管理</button>
    <button class="nav-item" data-page="masterdata"><span class="ico">📊</span> 主数据管理</button>
    <button class="nav-item" data-page="integration"><span class="ico">🔗</span> 集成管理</button>
    <button class="nav-item" data-page="extension"><span class="ico">🧩</span> 扩展管理</button>
    <button class="nav-item" data-page="generator"><span class="ico">&lt;/&gt;</span> 代码生成</button>
    <div class="nav-section">系统</div>
    <button class="nav-item" data-page="system"><span class="ico">⚙</span> 系统管理</button>
  </nav>
  <div class="sider-theme">
    <span style="font-size:13px">☀️</span>
    <button onclick="toggleTheme()"></button>
    <span style="font-size:13px">🌙</span>
  </div>
</aside>

<!-- Main -->
<main class="main">
  <header class="header">
    <div class="header-left">
      <span class="page-title" id="page-title">首页 · 仪表盘</span>
    </div>
    <div class="header-right">
      <button class="header-btn" title="通知 (3)">🔔<span style="position:absolute;top:2px;right:2px;width:8px;height:8px;background:var(--err);border-radius:50%"></span></button>
      <div class="user-badge"><div class="avatar">👤</div><span style="color:var(--t)">管理员</span></div>
    </div>
  </header>
  <div class="content" id="page-content"></div>
</main>
</div>

<!-- ================================================================ -->
<!-- PAGE TEMPLATES -->
<!-- ================================================================ -->

<!-- ═══════════════ 1. DASHBOARD ═══════════════ -->
<template id="tpl-dashboard">
  <p class="page-desc">BONE 平台首页 — <b>概览聚合 MVP</b>。对接 <b>bone-system ConsoleController</b>（5 GET 端点），<b>bone-shell</b> 默认 <b>30s 轮询刷新</b>。关键指标走 <b>JdbcKeyMetricsGateway</b>（graceful degradation，单表容错为 0）。</p>

  <div class="spec-panel">
    <div class="spec-row">
