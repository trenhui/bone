      <table><tbody>
        <tr><td>admin</td><td>创建账号「wangwu」</td><td style="color:var(--tt);font-size:11px">5 分钟前</td><td><span class="tag tag-ok">成功</span></td></tr>
        <tr><td>zhangsan</td><td>发布实体「客户信息」</td><td style="color:var(--tt);font-size:11px">15 分钟前</td><td><span class="tag tag-ok">成功</span></td></tr>
        <tr><td>admin</td><td>修改系统配置</td><td style="color:var(--tt);font-size:11px">25 分钟前</td><td><span class="tag tag-w">需重启</span></td></tr>
        <tr><td>wangwu</td><td>批量导入主数据</td><td style="color:var(--tt);font-size:11px">1 小时前</td><td><span class="tag tag-e">失败 23 条</span></td></tr>
      </tbody></table>
    </div>
  </div>

  <div class="interact-box" style="margin-top:16px">
    <div class="interact-title">🔄 数据刷新机制</div>
    <div class="interact-flow">
      <div class="interact-step key">bone-shell 30s timer</div><span class="interact-arrow">→</span>
      <div class="interact-step">GET /api/v1/console/overview</div><span class="interact-arrow">→</span>
      <div class="interact-step">JdbcKeyMetricsGateway</div><span class="interact-arrow">→</span>
      <div class="interact-step">COUNT 四张核心表 (graceful)</div>
    </div>
    <div class="interact-note">📊 Micrometer 计数器 <b>bone_console_overview_refresh_total</b> 作为 SLO 真源；单表缺失→字段返回 0，绝不阻断概览整体。</div>
  </div>
</template>

<!-- ═══════════════ 2. IAM ═══════════════ -->
<template id="tpl-iam">
  <p class="page-desc">身份与访问管理 — 基于 <b>RBAC</b> 模型，10 张 IAM 表。JWT claim <b>scopes</b> 解析为 GrantedAuthority，通过 <b>Spring Security @PreAuthorize</b> 方法级鉴权。</p>

  <div class="spec-panel">
    <div class="spec-row">
      <div class="spec-item"><span class="spec-key">API 前缀</span><span class="spec-val">/api/v1/iam</span></div>
      <div class="spec-item"><span class="spec-key">默认端口</span><span class="spec-val">8081</span></div>
      <div class="spec-item"><span class="spec-key">前端</span><span class="spec-val">bone-iam-app</span></div>
      <div class="spec-item"><span class="spec-key">鉴权</span><span class="spec-val">@PreAuthorize + 权限码</span></div>
    </div>
  </div>

  <div class="interact-box">
    <div class="interact-title">🖱️ 推荐交互模式 — 5 Tab 切换</div>
    <div class="interact-flow">
      <div class="interact-step key">点击 IAM 菜单</div><span class="interact-arrow">→</span>
      <div class="interact-step">默认「用户管理」Tab</div><span class="interact-arrow">→</span>
      <div class="interact-step">5 个 Tab 同页切换</div><span class="interact-arrow">→</span>
      <div class="interact-step">模态新建 / 行内编辑</div>
    </div>
    <div class="interact-note">💡 与旧版追加「<b>租户管理</b>」Tab。TenantController 已实现列表/创建/详情/更新/启停/配额 enforcement。</div>
  </div>

  <div class="tabs" id="iam-tabs">
    <button class="tab active" data-iam="users">👤 用户管理</button>
    <button class="tab" data-iam="roles">🔑 角色管理</button>
    <button class="tab" data-iam="permissions">🔒 权限管理</button>
    <button class="tab" data-iam="audit">📋 审计日志</button>
    <button class="tab" data-iam="tenants">🏢 租户管理</button>
  </div>

  <!-- Users -->
  <div id="iam-users">
    <div class="toolbar">
      <div class="toolbar-l"><button class="btn btn-p">+ 创建用户</button>
        <button class="btn btn-d btn-sm">批量导入</button>
        <button class="btn btn-d btn-sm">导出</button>
      </div>
      <div class="toolbar-r">
        <div class="search-box"><input placeholder="搜索用户名/邮箱..."><button>🔍</button></div>
      </div>
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <table><thead><tr><th>用户名</th><th>邮箱</th><th>角色</th><th>状态</th><th>最后登录</th><th>操作</th></tr></thead><tbody>
        <tr><td style="font-weight:500">admin</td><td>admin@bone.dev</td><td><span class="tag tag-i">超级管理员</span></td><td><span class="tag tag-ok">启用 (1)</span></td><td style="color:var(--tt);font-size:12px">14:35 · 刚刚</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑</button><button class="btn btn-l btn-sm" style="color:var(--err)">禁用</button><button class="btn btn-l btn-sm">重置密码</button></div></td></tr>
        <tr><td style="font-weight:500">zhangsan</td><td>zhangsan@bone.dev</td><td><span class="tag tag-d">开发人员</span></td><td><span class="tag tag-ok">启用 (1)</span></td><td style="color:var(--tt);font-size:12px">12:20 · 2h前</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑</button><button class="btn btn-l btn-sm" style="color:var(--err)">禁用</button></div></td></tr>
        <tr><td style="font-weight:500">wangwu</td><td>wangwu@bone.dev</td><td><span class="tag tag-d">集成工程师</span></td><td><span class="tag tag-e">锁定 (2)</span></td><td style="color:var(--tt);font-size:12px">— 连续 5 次失败</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑</button><button class="btn btn-l btn-sm" style="color:var(--suc)">解锁</button></div></td></tr>
      </tbody></table>
    </div>
    <div class="pag"><span class="pag-info">共 127 条</span><span class="pag-item">‹</span><span class="pag-item act">1</span><span class="pag-item">2</span><span class="pag-item">3</span><span class="pag-item">›</span></div>

    <div class="modal-inline" style="max-width:500px;margin-top:16px">
      <div class="mh">创建用户 <span style="font-size:12px;color:var(--tt);font-weight:400">POST /api/v1/iam/accounts → 201 + Location</span><span style="cursor:pointer;color:var(--tt)">✕</span></div>
      <div class="mb">
        <div class="fg-row">
          <div class="fg"><label>用户名 <span class="req">*</span></label><input placeholder="tenant_id 内唯一"></div>
          <div class="fg"><label>邮箱 <span class="req">*</span></label><input type="email" placeholder="user@bone.dev"></div>
        </div>
        <div class="fg"><label>密码 <span class="req">*</span></label><input type="password" placeholder="≥8 位，含大小写+数字+符号"><div class="help">强度: 弱 · [Target] 对齐 NIST 800-63B (≥12 + 弱口令字典)</div></div>
        <div class="fg"><label>角色</label><select><option>超级管理员</option><option>开发人员</option><option>集成工程师</option></select></div>
        <div class="fg"><label>密码策略</label><span class="tag tag-i" style="margin-top:4px">90天到期 · 首次登录强制改密</span></div>
      </div>
      <div class="mf"><button class="btn btn-d">取消</button><button class="btn btn-p">确定创建</button></div>
    </div>
  </div>

  <!-- Roles (placeholder for lazy load) -->
  <div id="iam-roles" style="display:none"></div>
  <div id="iam-perms" style="display:none"></div>
  <div id="iam-audit" style="display:none"></div>
  <div id="iam-tenants" style="display:none"></div>
</template>

