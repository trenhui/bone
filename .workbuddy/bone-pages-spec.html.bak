    <div class="stat"><div class="stat-label">内存</div><div class="stat-val" style="font-size:22px">68%</div><div style="width:100%;height:6px;background:var(--bs);border-radius:3px;margin-top:6px"><div style="width:68%;height:100%;background:var(--war);border-radius:3px"></div></div></div>
    <div class="stat"><div class="stat-label">API P99</div><div class="stat-val" style="font-size:22px">320ms</div><div style="font-size:12px;color:var(--suc);margin-top:4px">SLO &lt;500ms ✅</div></div>
