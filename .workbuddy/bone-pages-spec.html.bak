  <div class="card" style="padding:0;overflow:hidden">
    <table><thead><tr><th>实体名称</th><th>记录数</th><th>质量规则</th><th>质检通过率</th><th>状态</th><th>操作</th></tr></thead><tbody>
      <tr><td style="font-weight:500">客户主数据</td><td>1,280</td><td>6</td><td><span style="color:var(--suc);font-weight:500">96.5%</span></td><td><span class="tag tag-ok">已发布</span></td><td><div class="table-actions"><button class="btn btn-l btn-sm">数据记录</button><button class="btn btn-l btn-sm">质量规则</button><button class="btn btn-l btn-sm">导入</button></div></td></tr>
      <tr><td style="font-weight:500">产品主数据</td><td>356</td><td>4</td><td><span style="color:var(--war);font-weight:500">88.2%</span></td><td><span class="tag tag-ok">已发布</span></td><td><div class="table-actions"><button class="btn btn-l btn-sm">数据记录</button><button class="btn btn-l btn-sm">质量规则</button></div></td></tr>
    </tbody></table>
  </div>
</template>

<!-- ═══════════════ 5. INTEGRATION ═══════════════ -->
<template id="tpl-integration">
  <p class="page-desc">集成管理 — 连接器配置、<b>X6 可视化流程编排</b>、流程监控。当前运行时：<b>LinearSyncFlowRuntime</b>（START → HTTP → END 线性同步），完整 Camel 图执行为 [Vision]。</p>

  <div class="spec-panel">
    <div class="spec-row">
      <div class="spec-item"><span class="spec-key">API 前缀</span><span class="spec-val">/api/v1/integration</span></div>
      <div class="spec-item"><span class="spec-key">默认端口</span><span class="spec-val">8085</span></div>
      <div class="spec-item"><span class="spec-key">运行时</span><span class="spec-val">LinearSyncFlowRuntime</span></div>
