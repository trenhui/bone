      <div style="font-size:13px;line-height:2">
        <div style="font-weight:600;color:var(--t)">📁 控制台 <span style="font-size:10px;color:var(--tt);margin-left:4px">sys:console:read</span></div>
        <div style="padding-left:20px;color:var(--ts)">┗ dashboard</div>
        <div style="font-weight:600;color:var(--t);margin-top:4px">📁 IAM</div>
        <div style="padding-left:20px;color:var(--ts)">┣ 用户管理 <span class="tag tag-i" style="font-size:10px">MENU</span></div>
        <div style="padding-left:40px">┣ <span class="tag tag-w" style="font-size:10px">OP</span> 创建用户 · iam:account:create</div>
        <div style="padding-left:40px">┣ <span class="tag tag-w" style="font-size:10px">OP</span> 禁用用户 · iam:account:disable</div>
        <div style="padding-left:40px">┗ <span class="tag tag-w" style="font-size:10px">OP</span> 重置密码</div>
        <div style="padding-left:20px;color:var(--ts)">┣ 角色管理 <span class="tag tag-i" style="font-size:10px">MENU</span></div>
        <div style="padding-left:20px;color:var(--ts)">┗ 审计日志 <span class="tag tag-i" style="font-size:10px">MENU</span> <span class="tag tag-d" style="font-size:10px">DATA</span></div>
        <div style="font-weight:600;color:var(--t);margin-top:4px">📁 元数据 · 主数据 · 集成 · 扩展 · 代码生成</div>
        <div style="padding-left:20px;color:var(--tt)">...</div>
      </div>
    </div>
    <div class="card">
      <div class="card-title">权限码格式: {domain}:{resource}:{action}</div>
      <table><thead><tr><th>域</th><th>MENU</th><th>OPERATION</th><th>DATA</th></tr></thead><tbody>
        <tr><td>IAM</td><td style="font-weight:500">4</td><td style="font-weight:500">12</td><td style="font-weight:500">2</td></tr>
        <tr><td>元数据</td><td style="font-weight:500">3</td><td style="font-weight:500">8</td><td style="font-weight:500">1</td></tr>
        <tr><td>集成</td><td style="font-weight:500">2</td><td style="font-weight:500">6</td><td>—</td></tr>
        <tr><td>扩展</td><td style="font-weight:500">3</td><td style="font-weight:500">10</td><td>—</td></tr>
        <tr style="font-weight:600;background:var(--pb)">
          <td>合计</td><td>12</td><td>36</td><td>3</td>
        </tr>
      </tbody></table>
      <p style="font-size:11px;color:var(--tt);margin-top:10px">💡 JWT claim scopes 在 Spring 内映射为 GrantedAuthority；前端 Authorized 组件解析做 UX 路由守卫（后端鉴权为权威）。</p>
    </div>
  </div>
</template>

