    </div>
  </div>

  <div class="tabs" id="integ-tabs">
    <button class="tab active" data-integ="connectors">🔌 连接器</button>
    <button class="tab" data-integ="flows">🔄 流程管理</button>
    <button class="tab" data-integ="monitor">📊 流程监控</button>
  </div>

  <!-- Connectors -->
  <div id="integ-connectors">
    <div class="toolbar"><div class="toolbar-l"><button class="btn btn-p">+ 创建连接器</button></div></div>
    <div class="card-grid" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
      <div class="conn-card">
        <div class="cc-icon">🌐</div>
        <div class="cc-name">ERP 系统 API</div>
        <div class="cc-type">REST · http://erp.internal/api</div>
        <div class="cc-status"><span class="tag tag-ok">已连接</span></div>
      </div>
      <div class="conn-card">
        <div class="cc-icon">🗄</div>
        <div class="cc-name">生产数据库</div>
        <div class="cc-type">JDBC · MySQL 8.0 · 3306</div>
        <div class="cc-status"><span class="tag tag-ok">已连接</span></div>
      </div>
      <div class="conn-card">
        <div class="cc-icon">📨</div>
        <div class="cc-name">消息队列</div>
        <div class="cc-type">RocketMQ · 5.1 · topic:orders</div>
        <div class="cc-status"><span class="tag tag-w">待测试</span></div>
      </div>
      <div class="conn-card">
        <div class="cc-icon">📁</div>
        <div class="cc-name">FTP 文件服务</div>
        <div class="cc-type">FTP · ftp://fileserver:21</div>
        <div class="cc-status"><span class="tag tag-e">禁用</span></div>
      </div>
    </div>
  </div>

  <!-- Flows -->
  <div id="integ-flows" style="display:none">
    <div class="toolbar"><div class="toolbar-l"><button class="btn btn-p">+ 创建流程</button><button class="btn btn-d btn-sm">从模板创建</button></div></div>
    <div class="card" style="padding:0;overflow:hidden">
      <table><thead><tr><th>流程名称</th><th>节点数</th><th>状态</th><th>最近执行</th><th>操作</th></tr></thead><tbody>
        <tr><td style="font-weight:500">客户数据同步</td><td>5</td><td><span class="tag tag-ok">已激活</span></td><td style="color:var(--tt);font-size:12px">2 分钟前 · 成功 · 345ms</td><td><button class="btn btn-l btn-sm">编辑画布</button><button class="btn btn-l btn-sm">测试</button></td></tr>
        <tr><td style="font-weight:500">订单→ERP</td><td>3</td><td><span class="tag tag-ok">已激活</span></td><td style="color:var(--tt);font-size:12px">8 分钟前 · 成功 · 1.2s</td><td><button class="btn btn-l btn-sm">编辑画布</button><button class="btn btn-l btn-sm">测试</button></td></tr>
      </tbody></table>
    </div>

    <!-- Flow Mini: LinearSyncFlowRuntime -->
    <div style="margin-top:16px">
      <div class="card-title" style="font-size:13px;border-bottom:none;padding-bottom:0;margin-bottom:10px">📐 线性流程图 (As-Is · LinearSyncFlowRuntime)</div>
      <div class="flow-mini" style="background:var(--bl);border-radius:var(--rl);border:1px dashed var(--b)">
        <div class="flow-node start">START</div><div class="flow-arrow-h"></div>
        <div class="flow-node http">HTTP 调用</div><div class="flow-arrow-h"></div>
        <div class="flow-node">数据映射</div><div class="flow-arrow-h"></div>
        <div class="flow-node end">END</div>
      </div>
      <p style="font-size:11px;color:var(--tt);text-align:center;margin-top:8px">
        💡 分支/并行/循环为 [Vision] INT-11。画布 (X6) 可保存复杂拓扑，运行时仅保证线性路径。
      </p>
    </div>
  </div>

  <!-- Monitor placeholder -->
  <div id="integ-monitor" style="display:none"></div>
</template>

