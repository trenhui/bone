<!-- ═══════════════ 3. METADATA ═══════════════ -->
<template id="tpl-metadata">
  <p class="page-desc">元数据管理 — 业务实体建模。支持 <b>模式 A (GENERATIVE → 代码生成)</b> 与 <b>模式 B (RUNTIME → 动态 CRUD API)</b> 双模式交付。</p>

  <div class="interact-box">
    <div class="interact-title">🖱️ 交互模式 — 列表 → Drawer 详情</div>
    <div class="interact-flow">
      <div class="interact-step key">实体列表页</div><span class="interact-arrow">→</span>
      <div class="interact-step">点击行 → 右侧 Drawer 详情</div><span class="interact-arrow">→</span>
      <div class="interact-step">详情 Tab: 字段 / 关系 / 校验规则 / 版本历史</div>
    </div>
    <div class="interact-note">💡 API 路径约定：<b>扩展字段</b>走 /metadata/fields:* (动作式)，<b>建模 CRUD</b>走 /metadata/entities/{id}/fields (嵌套 REST)，<b>运行时</b>走 /api/v1/runtime/**。</div>
  </div>

  <div class="toolbar">
    <div class="toolbar-l"><button class="btn btn-p">+ 创建实体</button><button class="btn btn-d btn-sm">批量操作</button></div>
    <div class="toolbar-r"><div class="search-box"><input placeholder="搜索实体..."><button>🔍</button></div></div>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table><thead><tr><th>实体名称</th><th>字段数</th><th>交付模式</th><th>状态</th><th>版本</th><th>更新时间</th><th>操作</th></tr></thead><tbody>
      <tr><td style="font-weight:500">客户信息</td><td>12</td><td><span class="tag tag-i">GENERATIVE</span></td><td><span class="tag tag-ok">已发布 (status=1)</span></td><td>v3</td><td style="color:var(--tt);font-size:12px">2026-06-08</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑字段</button><button class="btn btn-l btn-sm" onclick="navTo('generator')">生成代码</button><button class="btn btn-l btn-sm" style="color:var(--err)">删除</button></div></td></tr>
      <tr><td style="font-weight:500">订单管理</td><td>18</td><td><span class="tag tag-d">RUNTIME</span></td><td><span class="tag tag-ok">已发布</span></td><td>v5</td><td style="color:var(--tt);font-size:12px">2026-06-05</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑字段</button><button class="btn btn-l btn-sm" style="color:var(--err)">删除</button></div></td></tr>
      <tr><td style="font-weight:500">供应商</td><td>8</td><td><span class="tag tag-i">GENERATIVE</span></td><td><span class="tag tag-w">草稿</span></td><td>v1</td><td style="color:var(--tt);font-size:12px">2026-06-10</td><td><div class="table-actions"><button class="btn btn-l btn-sm">编辑字段</button><button class="btn btn-l btn-sm">发布</button></div></td></tr>
    </tbody></table>
  </div>
  <p style="font-size:11px;color:var(--tt);margin-top:8px">💡 CATALOG_SNAPSHOT：generator 仅拉取 status=1 的元数据实体快照驱动代码生成。</p>
</template>

<!-- ═══════════════ 4. MASTER DATA ═══════════════ -->
