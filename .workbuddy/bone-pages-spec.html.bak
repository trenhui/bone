    <div class="card-title">☸️ Kubernetes 部署概览 <span style="font-weight:400;font-size:12px;color:var(--tt)">[Vision]</span></div>
    <table><thead><tr><th>组件</th><th>副本数</th><th>HPA</th><th>镜像版本</th><th>PDB</th></tr></thead><tbody>
      <tr><td style="font-weight:500">bone-gateway</td><td>2/2</td><td>2-8 (CPU 70%)</td><td style="font-family:monospace;font-size:11px">v0.5.1</td><td>minAvailable: 1</td></tr>
      <tr><td style="font-weight:500">bone-iam</td><td>3/3</td><td>3-10 (CPU 60%)</td><td style="font-family:monospace;font-size:11px">v0.5.1</td><td>minAvailable: 2</td></tr>
      <tr><td style="font-weight:500">bone-system</td><td>2/2</td><td>2-6 (CPU 50%)</td><td style="font-family:monospace;font-size:11px">v0.5.1</td><td>minAvailable: 1</td></tr>
      <tr><td style="font-weight:500">bone-extension-studio</td><td>1/1</td><td>—</td><td style="font-family:monospace;font-size:11px">v0.5.1</td><td>—</td></tr>
    </tbody></table>
    <p style="font-size:11px;color:var(--tt);margin-top:10px">💡 Helm Chart 一键部署 · 滚动更新 (maxSurge 25%, maxUnavailable 0) · Prometheus + Grafana 自动集成 [Vision]。</p>
  </div>
</template>

<!-- ================================================================ -->
<!-- SCRIPTS -->
<!-- ================================================================ -->
<script>
// Page Config
const pages = {
  dashboard:  { title: '首页 · 仪表盘', tpl: 'tpl-dashboard' },
  iam:        { title: 'IAM 管理 · 账号权限', tpl: 'tpl-iam', subs: ['users','roles','perms','audit','tenants'], lazyTpls: {roles:'tpl-iam-roles',perms:'tpl-iam-perms',audit:'tpl-iam-audit',tenants:'tpl-iam-tenants'} },
  metadata:   { title: '元数据管理 · 业务建模', tpl: 'tpl-metadata' },
  masterdata: { title: '主数据管理 · 数据治理', tpl: 'tpl-masterdata' },
  integration:{ title: '集成管理 · 连接与编排', tpl: 'tpl-integration', subs: ['connectors','flows','monitor'], lazyTpls: {monitor:'tpl-integ-monitor'} },
  extension:  { title: '扩展管理 · ExtPoint 引擎', tpl: 'tpl-extension', subs: ['points','plugins','deploy','depgraph','marketplace','logs'], lazyTpls: {plugins:'tpl-ext-plugins',deploy:'tpl-ext-deploy',depgraph:'tpl-ext-depgraph',marketplace:'tpl-ext-marketplace',logs:'tpl-ext-logs'} },
  generator:  { title: '代码生成 · Studio Generator', tpl: 'tpl-generator', subs: ['datasource','codegen','templates','history'], lazyTpls: {codegen:'tpl-gen-codegen',templates:'tpl-gen-templates',history:'tpl-gen-history'} },
  system:     { title: '系统管理 · 运维配置', tpl: 'tpl-system', subs: ['config','monitor','logs','k8s'], lazyTpls: {monitor:'tpl-sys-monitor',logs:'tpl-sys-logs',k8s:'tpl-sys-k8s'} },
};

function switchPage(pageId) {
  const p = pages[pageId];
  document.getElementById('page-title').textContent = p.title;
  const content = document.getElementById('page-content');
  const tpl = document.getElementById(p.tpl);
  content.innerHTML = tpl.innerHTML;

  // Rebind all known tab groups
  bindTabs('iam-tabs', 'iam', p.subs, p.lazyTpls);
  bindTabs('integ-tabs', 'integ', p.subs, p.lazyTpls);
  bindTabs('ext-tabs', 'ext', p.subs, p.lazyTpls);
  bindTabs('gen-tabs', 'gen', p.subs, p.lazyTpls);
  bindTabs('sys-tabs', 'sys', p.subs, p.lazyTpls);

  document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
  const navBtn = document.querySelector(`.nav-item[data-page="${pageId}"]`);
  if (navBtn) navBtn.classList.add('active');
}

function bindTabs(tabGroupId, prefix, subs, lazyTpls) {
  const tabGroup = document.getElementById(tabGroupId);
  if (!tabGroup) return;

  // Hide all sub containers
  if (subs) subs.forEach(s => {
    const el = document.getElementById(prefix+'-'+s);
    if (el) el.style.display = 'none';
  });
  // Show first active
  const firstActive = tabGroup.querySelector('.tab.active');
  if (firstActive && subs) {
    const sub = firstActive.dataset[prefix];
    const el = document.getElementById(prefix+'-'+sub);
    if (el) el.style.display = 'block';
  }

  tabGroup.querySelectorAll('.tab').forEach(t => {
    t.onclick = function() {
      tabGroup.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
      this.classList.add('active');
      const sub = this.dataset[prefix];
      if (subs) subs.forEach(s => {
        const el = document.getElementById(prefix+'-'+s);
        if (el) el.style.display = 'none';
      });
      const target = document.getElementById(prefix+'-'+sub);
      if (target) {
        target.style.display = 'block';
        // Lazy load template if needed
        if (lazyTpls && lazyTpls[sub] && !target.hasChildNodes()) {
          const lt = document.getElementById(lazyTpls[sub]);
          if (lt) target.innerHTML = lt.innerHTML;
        }
      }
    };
  });
}

function toggleTheme() {
  const html = document.documentElement;
  html.setAttribute('data-bone-theme', html.getAttribute('data-bone-theme') === 'light' ? 'dark' : 'light');
}

window.navTo = function(pageId) { switchPage(pageId); };

// Init
document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', function() { switchPage(this.dataset.page); });
});
switchPage('dashboard');
</script>
</body>
</html>
