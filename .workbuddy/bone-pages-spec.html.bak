  </div>

  <div id="sys-config">
    <div class="card-grid-2">
      <div class="card">
        <div class="card-title">全局参数</div>
        <div class="fg"><label>服务端口范围</label><input value="9000-9099"></div>
        <div class="fg"><label>会话超时</label><select><option>30 分钟</option><option>60 分钟</option><option>120 分钟</option></select></div>
        <div class="fg"><label>日志级别</label><select><option>INFO</option><option>DEBUG</option><option>WARN</option></select></div>
        <div class="fg"><label>API 分页上限</label><input value="100"></div>
        <button class="btn btn-p btn-sm">保存配置</button>
      </div>
      <div class="card">
        <div class="card-title">功能开关</div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--bs)"><span style="color:var(--t)">代码生成</span><span class="tag tag-ok">开启</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--bs)"><span style="color:var(--t)">主数据管理</span><span class="tag tag-ok">开启</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--bs)"><span style="color:var(--t)">多租户</span><span class="tag tag-e">关闭 (商业版)</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0"><span style="color:var(--t)">SSO 集成</span><span class="tag tag-e">关闭 (商业版)</span></div>
      </div>
    </div>
  </div>

  <div id="sys-monitor" style="display:none"></div>
  <div id="sys-logs-dynamic" style="display:none"></div>
  <div id="sys-k8s" style="display:none"></div>
</template>

