# 保留重要的Maven包装器
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# 源代码目录（确保不会被意外忽略）
!**/src/main/**
!**/src/test/**
!**/src/it/**
!**/src/assembly/**

# Extension Studio 本地运行时产物（H2 / 插件目录）
bone-engine/bone-extension-engine/bone-extension-studio/data/

# ArchUnit 测试运行时生成的规则缓存目录（每次运行生成新 uuid 子目录，不入库；
# 顶层 stored.rules 是规则基线，保留跟踪）
bone-engine/bone-extension-engine/bone-extension-studio/archunit_store/*/

# =========================
# 构建输出目录
# =========================
target/
bin/
gen/
build/
dist/
out/
classes/
generated-sources/

# 例外：DDD 目标态端口包 application/port/out（上面的 out/ 会连它一起忽略，
# 导致新增端口文件被静默跳过、git add 报 "ignored by .gitignore"）
!**/application/port/out/

# =========================
# Java相关文件
# =========================
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# =========================
# Python 门禁脚本的字节码缓存
# =========================
# scripts/ 下有 20+ 个 python3 门禁（check-*.py / ci/ / frontend/），
# 本机跑一次就会生成 __pycache__；无规则时它们会混进 `git status` 未跟踪列表，
# 存在被 `git add -A` 误提交的风险（提交的是编译产物，且会让 diff 噪声化）。
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# =========================
# IDE配置文件
# =========================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Eclipse
.settings/
.classpath
.project
.metadata/
*.launch
*.wtpmodules
.settings/

# VS Code
.vscode/
*.code-workspace

# NetBeans
nbproject/

# STS
.sts4-cache/

# =========================
# 系统文件
# =========================
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# =========================
# 日志文件
# =========================
logs/
log/
*.log
# 例外（必须保留在 log/ 之后）：Java 包名可能就叫 log，
# 上面的 `log/` 会连源码目录一起吞掉，导致该包从未入库 ——
# 典型事故：com.bone.system.domain.model.log 被静默忽略，
# 而引用它的类已提交，clean checkout / CI 编译必然失败。
!**/src/main/java/**/log/
!**/src/test/java/**/log/
nohup.out
*.pid
*.seed
*.pid.lock

# =========================
# 临时文件
# =========================
temp/
tmp/
.cache/
.tmp/
.temp/
*.tmp
*.temp
.apt_generated/
*.swp
*.swo
*~

# =========================
# 环境变量和敏感信息
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.properties
# 例外：测试资源目录里的 application.properties 是测试夹具，不是本机私有配置，
# 被 `*.properties` 吞掉会让 clean checkout 少掉测试所需配置。
!**/src/test/resources/application.properties
# ArchUnit 冻结基线的**开关**必须进库。freeze.store.default.allowStoreUpdate=false 的语义是
# 「新增违规必须变红」，一旦文件不存在（被上面的 *.properties 吞掉，或漏配），ArchUnit 回落到
# 默认值 true ⇒ 第一次跑测试就把新增违规写进基线、此后永久豁免 —— 门禁还在跑，判断已经失效。
# 2026-10-04：`bone-architecture-test` 共享库被 10 个模块复用，此前只有 bone-masterdata 一份，
# 且它是被 `git add -f` 硬塞进来的；新建的 9 份会被 *.properties 静默忽略，clean checkout 上
# 等于一个都没配。此处开例外，并由 scripts/check-archunit-freeze-baseline.py 双重复核
# （文件存在 + 已被 git 跟踪，两条缺一即失败）。
!**/src/test/resources/archunit.properties
*.secret

