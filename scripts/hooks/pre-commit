#!/bin/sh
# 入库版 pre-commit（由 scripts/setup-hooks.sh 安装到 .git/hooks/pre-commit）。
#
# 三道闸，都**不复制**门禁清单：
#   1. 接口变更 ↔ e2e 用例同步：暂存的 Controller 若有端点零覆盖就阻断；
#      纯重构/改名不便补用例时，可用 `BONE_E2E_IMPACT=off git commit ...` 显式跳过。
#   2. 自动更新受影响功能的派生映射（impact-map.json / data-assets.json coverage）并加入本次提交；
#      随后校验「功能变更 → 造数资产同步」义务。业务用例与断言不自动生成，避免空壳用例造成假绿。
#   3. 全量本地自检：交给 check.sh（门禁清单、造数真实性、熔断计数都在那边）。
cd "$(git rev-parse --show-toplevel)" || exit 2

if [ "${BONE_E2E_IMPACT:-on}" != "off" ]; then
  if ! python3 scripts/e2e/impact.py --staged --strict; then
    echo ""
    echo "阻断：暂存的 Controller 变更存在『零覆盖端点』。"
    echo "处理：按上面建议命令生成用例并补断言；确属纯重构可 BONE_E2E_IMPACT=off git commit ..."
    exit 1
  fi
fi

if [ "${BONE_DATA_IMPACT:-on}" != "off" ]; then
  python3 scripts/e2e/impact.py --write-map || exit 1
  python3 scripts/check-feature-data-impact.py --write-map || exit 1

  # 只把「真的变了」的派生文件按路径加入本次提交，不用 git add -A（并发提交者会共用 index）。
  for DERIVED in scripts/e2e/impact-map.json scripts/registry/data-assets.json; do
    if ! git diff --quiet -- "$DERIVED" || ! git ls-files --error-unmatch "$DERIVED" >/dev/null 2>&1; then
      git add -- "$DERIVED" || exit 1
      echo "pre-commit: 已自动更新并加入提交: $DERIVED"
    fi
  done

  if ! python3 scripts/check-feature-data-impact.py --staged --strict; then
    echo ""
    echo "阻断：后端功能/DDL/Entity 变更未同步造数资产或 E2E 用例。"
    echo "处理：按上面清单同批更新；确属无需同步在 registry/data-assets.json 的 acks 登记 owner/reason/expires。"
    exit 1
  fi
fi

exec ./scripts/check.sh
