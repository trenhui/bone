# scripts/e2e/.env.example —— E2E 环境变量唯一清单（复制为 .env 后 source 或 export）
#
# 真源：e2e_lib/config.py（Python）与 e2e_lib/client.cjs（Node）各自读这些变量；
# 两处默认值必须保持同步（改一处须同步另一处，否则出现「Python 走网关、Node 走直连」的错位）。
# 本文件是所有 BONE_E2E_* / BONE_* 变量的单一出处，新增变量请先登记于此。

# ---- 网关 / API 根（含 /api/v1）----
# 默认走网关 = 真联调；直连后端排查时改 BONE_E2E_BASE 与 BONE_E2E_LOGIN_BASE
BONE_E2E_BASE=http://127.0.0.1:8888/api/v1
# 登录端点单独可配：直连 metadata(:9001) 时该端口不承载 /api/v1/iam/**，须打到 IAM(:8081)
BONE_E2E_LOGIN_BASE=http://127.0.0.1:8888/api/v1

# ---- 主会话凭据（本地种子账号；CI / 其它环境注入真实凭据）----
BONE_E2E_USER=admin
BONE_E2E_PWD=123456
# 租户请求头 X-Tenant-Id
BONE_E2E_TENANT=0
# 单请求超时（秒）
BONE_E2E_TIMEOUT=40

# ---- 前端壳层 / IAM 直连（UI 探针 + preflight --ui 共用）----
BONE_UI_BASE=http://localhost:3000
BONE_IAM_BASE=http://127.0.0.1:8081

# ---- CI 机器可读结果 ----
# 设了**目录**后，report.py 与 client.cjs 会把断言写成 <目录>/<套件名>.xml
# （标准 JUnit，31 个脚本无需改动）；不设则零副作用。
# 必须是目录而非单个文件：一次 CI 跑几十个脚本，共用文件会互相覆盖（后写者赢）。
BONE_E2E_JUNIT_DIR=
# 套件名缺省取脚本文件名（如 ui-create-data-probe），多脚本汇总时可覆盖
BONE_E2E_JUNIT_SUITE=

# ---- 快检开关 ----
# 1 = run.sh 的业务层分组跳过快检（明知栈已备好、快速重跑时用）
BONE_E2E_SKIP_PREFLIGHT=0

# ---- 第二证据源：MySQL 直查（防「接口 200 但没落库」的假绿）----
BONE_E2E_MYSQL=/usr/local/mysql-8.0.31-macos12-x86_64/bin/mysql
BONE_E2E_MYSQL_HOST=127.0.0.1
BONE_E2E_MYSQL_PORT=3306
BONE_E2E_MYSQL_USER=root
BONE_E2E_MYSQL_PWD=mysql123
BONE_E2E_MYSQL_DB=bone

# ---- SoD 审批人（三样板采购审批账号）----
BONE_E2E_APPROVER_USER=
BONE_E2E_APPROVER_PWD=
BONE_E2E_APPROVER_DEPT_ID=

# ---- 残留策略 ----
# 1 = 跑完保留残留现场（供 UI 探针消费 / 排查）；默认清理
BONE_E2E_KEEP_RESIDUE=0
# 运行态交接件路径（全链路 → UI 探针的状态文件）
BONE_E2E_STATE=/tmp/bone_e2e_fullchain_state.json
# 截图 / 证据落盘目录
BONE_E2E_SHOT_DIR=

# ---- 样例协议目录（建模侧界面协议样例真源）----
BONE_E2E_SAMPLES=

# ---- Node 探针私有：playwright 模块解析（NODE_PATH 兜底）----
# NODE_PATH=~/.workbuddy/binaries/node/workspace/node_modules
