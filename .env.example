# Bone 本地开发环境变量
# 复制此文件为 .env 并填写实际值
# 注意：.env 文件已被 .gitignore 忽略，不会提交到 Git 仓库

BONE_DB_HOST=127.0.0.1
BONE_DB_PORT=3306
BONE_DB_NAME=bone
BONE_DB_URL=jdbc:mysql://127.0.0.1:3306/bone?useSSL=false&autoReconnect=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
BONE_DB_USERNAME=root
BONE_DB_PASSWORD=your_database_password

# Redis
BONE_REDIS_HOST=127.0.0.1
BONE_REDIS_PORT=6379
BONE_REDIS_PASSWORD=your_redis_password

# IAM / 安全
# JWT 密钥必须 >= 32 字节，生产环境务必替换
BONE_JWT_SECRET=your_jwt_secret_key_at_least_32_chars!!
BONE_JWT_EXPIRATION_MS=7200000
BONE_JWT_REFRESH_EXPIRATION_MS=604800000

# CORS 配置（逗号分隔的允许源）
BONE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003

# MinIO 配置
BONE_MINIO_ENDPOINT=http://localhost:9000
BONE_MINIO_ACCESS_KEY=minioadmin
BONE_MINIO_SECRET_KEY=minioadmin
BONE_MINIO_BUCKET_NAME=audit-logs

# Spring
SPRING_PROFILES_ACTIVE=dev

# 服务端口
BONE_SERVER_PORT=8081
