# Bone 本地开发环境变量（模板）
# 用法：cp .env.example .env 后按本机修改；.env 已加入 .gitignore，勿提交。
# 启动后端前：source scripts/dev/load-env.sh

# --- MySQL（本地实例或 docker-compose 中的 mysql 服务）---
BONE_DB_HOST=127.0.0.1
BONE_DB_PORT=3306
BONE_DB_NAME=bone
BONE_DB_URL=jdbc:mysql://127.0.0.1:3306/bone?useSSL=false&autoReconnect=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
BONE_DB_USERNAME=root
# 本地 MySQL root 密码（示例；请改为你的实际密码）
BONE_DB_PASSWORD=mysql123

# --- Redis ---
BONE_REDIS_HOST=127.0.0.1
BONE_REDIS_PORT=6379
BONE_REDIS_PASSWORD=

# --- IAM / 安全（仅开发；生产必须使用强随机值并由密钥管理注入）---
BONE_JWT_SECRET=dev-only-replace-with-32-chars-minimum!!
BONE_JWT_EXPIRATION_MS=7200000
BONE_JWT_REFRESH_EXPIRATION_MS=604800000

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
# BONE_SERVER_PORT=8081

# --- 平台集成 bone-platform-integration（默认 :8085，context-path /api）---
# 领域事件告警：true 时走 bone-notification；通道默认关闭，仅写日志
BONE_INTEGRATION_ALERT_ENABLED=true
# 生产鉴权（开发可 false）
# BONE_INTEGRATION_JWT_ENABLED=false

# 钉钉机器人（失败类事件 HIGH 级别；启用须同时设 webhook）
# BONE_ALERT_DINGTALK_ENABLED=true
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# DINGTALK_SECRET=

# 邮件（须配置 spring.mail.*，见 bone-integration application-dev 或本机 SMTP）
# BONE_ALERT_MAIL_ENABLED=true
# BONE_ALERT_MAIL_FROM=alerts@bone.local
# BONE_ALERT_MAIL_TO=ops@bone.local

# --- 可选：Compose ---
# COMPOSE_PROJECT_NAME=bone
