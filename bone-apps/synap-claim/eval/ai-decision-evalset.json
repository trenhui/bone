{
  "schemaVersion": 1,
  "evalsetId": "claim-ai-decision-regression",
  "status": "declared",
  "owner": "synap-claim",
  "scope": "AI 结论与决策分诊档位的确定性回归；不含金额计算、不触碰资金状态",
  "groundTruthPolicy": {
    "provenance": "每条用例标注 groundTruthRef（仓库内真源 path#anchor）与 regulatoryBasis；期望值来自真源或源码契约，不由模型生成",
    "piiFree": true,
    "piiPolicy": "监管 §24：PII 禁入评测集。样本均为合成常量与受控枚举，无真实姓名/证件号/手机号/银行卡/病历",
    "frozenSetDiscipline": "冻结集只用于回归判定，不参与训练、不参与提示词调优（防 Hidden Feedback Loop / 评测集污染）",
    "changePolicy": "模型版本、提示词契约版本、规则集、分诊阈值任一变更，必跑本集；失败阻断发布并留痕"
  },
  "suites": [
    {
      "id": "decisionTriage",
      "testClass": "DecisionTriageGoldenSetTest",
      "description": "决策分诊阈值与档位路由（13 例：1 全绿基准 + 12 异常/转人工负向）"
    },
    {
      "id": "aiAssessNode",
      "testClass": "AiAssessNodeHandlerTest",
      "description": "AI 评估节点三态能力语义：无法判定 ≠ 拒赔、降级不改口径、认知层只留痕"
    },
    {
      "id": "capabilityReadiness",
      "testClass": "AiCapabilityReadinessServiceTest",
      "description": "部署态能力声明 fail-closed 与清单边界：UNKNOWN 缺省、清单不等于放款许可"
    },
    {
      "id": "readinessController",
      "testClass": "AiCapabilityReadinessControllerTest",
      "description": "只读治理端点契约：复用既有权限点、无额外副作用"
    },
    {
      "id": "aiDisclosureDomain",
      "testClass": "AiDecisionDisclosureTest",
      "description": "AI 参与决策披露三态判定：无法确认≠AI 未参与、版本快照不得冒充参与证据、标识不得把 AI 说成决定者"
    },
    {
      "id": "aiDisclosureService",
      "testClass": "AiDecisionDisclosureServiceTest",
      "description": "只读披露服务：跨案 traceId fail-closed、JSON 解析失败不压成无风险、版本串截断防自由文本外溢"
    },
    {
      "id": "aiDisclosureController",
      "testClass": "AiDecisionDisclosureControllerTest",
      "description": "告知端点契约：复用既有 claim:claims:read、纯 GET 无写副作用、参数如实透传"
    }
  ],
