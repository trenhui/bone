<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.bone</groupId>
        <artifactId>bone-metadata-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../bone-engine/bone-metadata-engine/pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>bone-app-expense</artifactId>
    <name>bone-app-expense</name>
    <description>报销业务应用：报销单写前钩子（冻结/发票查重）+ 借款与报销打款逃逸处理器。</description>
    <packaging>jar</packaging>

    <properties>
        <jacoco.minimum.coverage>0</jacoco.minimum.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-engine-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 审批流引擎（平台集成 starter）：报销提交/审批/驳回/撤回四动作经逃逸 Handler 驱动引擎，
             任务/待办/指派冻结/会签原子推进/挂起干预由引擎承担（设计文档 doc/design/modules/12. §8）。
             引擎持久化已由 starter 收敛到 bone-metadata-sdk @Sql（2026-10-24），wf_* 六表 DDL 见
             scripts/migration/0056_wf_workflow_tables.sql（引擎侧）与 0057_expense_workflow_seed.sql（报销种子）——
             表缺失时读写运行期报错，刻意不兜底。 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-workflow-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 会计引擎（可复用横向能力）：凭证公式/条件求值 + 凭证生成。
             仅依赖即自动装配 voucherGenerateHandler（AccountingEngineAutoConfiguration），
             业务侧在动作定义声明 handler_bean=voucherGenerateHandler 即复用，差异全在配置数据
             （fin_voucher_template / fin_account_mapping，见迁移 0067）。打款/pay 终态经
             generateVoucher 动作触发「业务终态 → 会计凭证」（业财一体方案 doc/design/modules/12 §3/§4）。 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-accounting-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
            <version>${bone-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <version>${bone-architecture-test.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
