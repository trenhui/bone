<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bone.procurement</groupId>
        <artifactId>bone-procurement</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bone-procurement-contract</artifactId>
    <name>bone-procurement-contract</name>
    <description>采购合同 AI 辅助审查上下文（procuraAI walking skeleton）：DDD 四层，AI 能力全部经出站端口调用 bone-ai-*。</description>

    <dependencies>
        <!-- Web / Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Bone 共享内核：版本由 bone-parent dependencyManagement 托管 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-metadata-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Bone AI 底座：1.0.0-SNAPSHOT 已在 bone-parent dependencyManagement，不写 version -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-ai-document</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-ai-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-ai-trace</artifactId>
        </dependency>

        <!-- Bone Security：参照 synap-claim-app/pom.xml 显式声明版本 -->
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bone</groupId>
            <artifactId>bone-architecture-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
