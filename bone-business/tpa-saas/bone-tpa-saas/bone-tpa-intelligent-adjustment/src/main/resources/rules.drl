// Generated DRL File for Medical Insurance TPA Adjustment Engine
package com.bone.tpa.intelligent.adjustment.rule

import com.bone.tpa.intelligent.adjustment.model.liability.InvoiceAdjustmentContext
import com.bone.tpa.intelligent.adjustment.model.Responsibility
import com.bone.tpa.intelligent.adjustment.model.Invoice
import com.bone.tpa.intelligent.adjustment.model.Policy
import java.util.Map
import java.util.HashMap

// 定义临时计算结果存储
declare TempResult
    responsibilityId: String
    amountBeforeDeductible: double
    amountAfterDeductible: double
    frozenAmount: double
end

// 规则1：匹配适用责任并初始化计算
rule "Match Applicable Responsibilities"
    salience 100
    when
        $context: ClaimContext($invoice: invoice, $responsibilities: responsibilities)
        $responsibility: Responsibility(
            applicableMedicalTypes contains $invoice.getMedicalType(),
            applicableHospitalLevels contains $invoice.getHospitalLevel(),
            applicableCatalogItems contains $invoice.getCatalogItem()
        ) from $responsibilities
    then
        // 根据费用类型获取赔付比例
        double ratio = $responsibility.getPayoutRatioFor($invoice.getExpenseType());
        double amount = $invoice.getAmount() * ratio;

        // 创建临时计算结果
        TempResult tr = new TempResult();
        tr.setResponsibilityId($responsibility.getId());
        tr.setAmountBeforeDeductible(amount);
        insert(tr);

        // 记录匹配的责任
        $context.addMatchedResponsibility($responsibility);
end

// 规则2：处理绝对免赔（年度）
rule "Apply Absolute Annual Deductible"
    salience 90
    when
        $context: ClaimContext($policy: policy)
        $responsibility: Responsibility(
            deductible.type == "ABSOLUTE",
            deductible.method == "ANNUAL"
        ) from $context.getMatchedResponsibilities()
        $tr: TempResult(
            responsibilityId == $responsibility.getId(),
            amountBeforeDeductible > 0
        )
    then
        // 获取年度累计免赔额
        double annualDeductibleUsed = $policy.getAnnualDeductibleUsed($responsibility.getId());
        double remainingDeductible = $responsibility.getDeductible().getAmount() - annualDeductibleUsed;

        if(remainingDeductible > 0) {
            double deductibleToApply = Math.min(remainingDeductible, $tr.getAmountBeforeDeductible());
            $tr.setAmountAfterDeductible($tr.getAmountBeforeDeductible() - deductibleToApply);
            $policy.updateAnnualDeductible($responsibility.getId(), deductibleToApply);
        } else {
            $tr.setAmountAfterDeductible($tr.getAmountBeforeDeductible());
        }
        update($tr);
end

// 规则3：处理按次免赔
rule "Apply Per Claim Deductible"
    salience 90
    when
        $responsibility: Responsibility(
            deductible.type == "ABSOLUTE",
            deductible.method == "PER_CLAIM"
        ) from $context.getMatchedResponsibilities()
        $tr: TempResult(
            responsibilityId == $responsibility.getId(),
            amountBeforeDeductible > 0
        )
    then
        double deductibleAmount = Math.min(
            $responsibility.getDeductible().getAmount(),
            $tr.getAmountBeforeDeductible()
        );
        $tr.setAmountAfterDeductible($tr.getAmountBeforeDeductible() - deductibleAmount);
        update($tr);
end

// 规则4：额度冻结控制
rule "Freeze Payment Amount"
    salience 80
    when
        $context: ClaimContext($policy: policy)
        $tr: TempResult(
            amountAfterDeductible > 0,
            frozenAmount == 0
        )
        $responsibility: Responsibility() from $context.getMatchedResponsibilities()
    then
        // 获取实时额度（假设已从外部接口获取并设置到policy）
        double availableQuota = $policy.getAvailableQuota($responsibility.getId());
        double amountToFreeze = Math.min(availableQuota, $tr.getAmountAfterDeductible());

        // 冻结金额处理
        $tr.setFrozenAmount(amountToFreeze);
        $policy.freezeQuota($responsibility.getId(), amountToFreeze);
        update($tr);

        // 累加计算结果
        $context.addCalculatedAmount(amountToFreeze);
end

// 规则5：同类责任合并验证
rule "Validate Same Insurance Type"
    salience 70
    when
        $context: ClaimContext($policy: policy)
        $trGroup: List() from collect(
            TempResult(
                responsibilityId in $context.getGroupInsuranceResponsibilities(),
                frozenAmount > 0
            )
        )
    then
        // 团险合并逻辑（示例）
        double groupTotal = $trGroup.stream().mapToDouble(t -> t.getFrozenAmount()).sum();
        if(groupTotal > $policy.getGroupQuotaLimit()) {
            // 超额处理逻辑
            $context.setValidationError("团体保险总额度超限");
        }
end

// 规则6：最终结果验证
rule "Final Validation"
    salience 50
    when
        $context: ClaimContext(calculatedAmount > 0, $policy: policy)
    then
        // 验证1：历史赔付对比
        if($context.getCalculatedAmount() > $policy.getHistoricalAverage() * 2) {
            $context.setValidationWarning("赔付金额超过历史平均值200%");
        }

        // 验证2：保单总额度检查
        if($context.getCalculatedAmount() > $policy.getTotalLimit()) {
            $context.setCalculatedAmount($policy.getTotalLimit());
            $context.setValidationError("超过保单总限额");
        }
end